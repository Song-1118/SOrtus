# SOrtus 编辑器与代码风格配置（规范 6.1）
# 说明：.editorconfig 无法强制 BOM，源文件统一以 UTF-8（含 BOM）保存。

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{json,md,xaml,resx,sql,ps1}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.resx]
indent_size = 2
