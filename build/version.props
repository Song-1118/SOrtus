<Project>

  <!--
    版本号单一来源（规范 9.3 / 12.1）。
    程序集版本、文件版本、安装包版本、关于页版本四者必须一致。
    MVP 阶段主版本为 0（0.x.y），到达 1.0.0 后严格遵守 SemVer。
  -->
  <PropertyGroup>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <PackageVersion>0.3.0</PackageVersion>
  </PropertyGroup>

</Project>
