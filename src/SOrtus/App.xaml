<Application x:Class="SOrtus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SOrtus">
    <Application.Resources>
        <!--
            全局资源入口（规范 7.2 / 验收 A13）：只保留两个总入口。
              1) 主题字典（Theme.xaml，内部嵌套 Light/Dark，运行时由 ThemeService 整本替换）
              2) 样式总入口（Styles.xaml，内部按依赖顺序合并全部令牌与控件样式）
            跨字典的 StaticResource 不再靠平铺解决——各字典已在自己的 MergedDictionaries 里
            声明依赖（Blur→Sizes、Dialog→Card、ViewTemplates→Dialog），加载期即可见。
            主题键一律经 DynamicResource 引用，运行时可递归遍历合并树。
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Theme.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
