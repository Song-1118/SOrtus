<Application x:Class="SOrtus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SOrtus">
    <Application.Resources>
        <!--
            全局资源入口（规范 7.2）：所有叶子字典平铺为 Application.Resources 的直接子项。
            原因：WPF 的 StaticResource 不会向下遍历嵌套的 MergedDictionaries，
            只有平铺到共同祖先层，跨字典的 StaticResource 引用（如 Dialog→Card 的
            BlurCardStyle、ViewTemplates→Dialog 的 BlurDialogStyle、MainWindow→Dialog 的
            ScrimBrush、Blur→Sizes 的 BlurRadius*）才能互相可见。
            主题字典（Theme.xaml）保留嵌套 Light/Dark 以支持运行时整体替换，
            主题键一律经 DynamicResource 引用（会递归遍历合并树）。
            顺序：依赖方在前，被依赖方在后。
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题（嵌套 Light/Dark，运行时可整体替换；键经 DynamicResource 引用） -->
                <ResourceDictionary Source="Resources/Themes/Theme.xaml" />

                <!-- 令牌层 -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Brushes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Sizes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Animations.xaml" />
                <ResourceDictionary Source="Resources/Styles/Blur.xaml" />
                <ResourceDictionary Source="Resources/Styles/Icons.xaml" />

                <!-- 控件样式层（按依赖顺序：Base → Button → Input → Card → Display → Dialog） -->
                <ResourceDictionary Source="Resources/Styles/Controls.Base.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.Button.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.Input.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.Card.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.Display.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.Dialog.xaml" />

                <!-- 视图模板（依赖上述所有控件样式与对话框样式，放在最后） -->
                <ResourceDictionary Source="Resources/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
