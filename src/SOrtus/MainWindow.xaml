<Window x:Class="SOrtus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SOrtus.Controls"
        xmlns:conv="clr-namespace:SOrtus.Converters"
        Title="{DynamicResource App_Title}"
        Height="760" Width="1180"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Resources/icon/app.ico"
        Background="{DynamicResource WallpaperBrush}">

    <!--
        VD-060（P0）：窗口三键并入应用顶栏。
        写法：WindowStyle=None + WindowChrome。
          · GlassFrameThickness=0 —— 去掉系统玻璃边框，客户区直达窗口边缘；
          · CaptionHeight=44 —— 顶栏整条仍是「系统标题栏」：拖动、双击最大化、Aero Snap、
            右键系统菜单、拖到屏幕边缘分屏全部由操作系统处理，不需要自己写 DragMove；
          · UseAeroCaptionButtons=False —— 系统三键不再绘制，由下方顶栏自绘（CaptionButtonStyle）；
          · ResizeBorderThickness=6 —— 保留四周拖拽改尺寸的命中区（无边框窗必须显式给）。
        顶栏内的可交互元素需标 WindowChrome.IsHitTestVisibleInChrome="True"，否则点击会被当成拖窗口。
        最大化时的工作区尺寸由 MainWindow.xaml.cs 的 WM_GETMINMAXINFO 钩子限制，避免无边框窗
        最大化后溢出到屏幕外、盖住任务栏。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}" />
    </Window.InputBindings>

    <!-- 背景层与内容层分离：PART_Backdrop 是磨砂卡片的模糊取样源（BlurPanel 以它为背景采样，
         卡片本身不在其视觉树内，避免自引用递归），保证「模糊的是背景、不是内容」。
         文本默认前景与字族在这里统一下发（TextElement 继承），主题切换自动生效；
         控件内部的局部 Foreground（如主按钮白字、标签色调）优先级更高，会正确覆盖。 -->
    <Grid x:Name="PART_Shell"
          TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
          TextElement.FontFamily="{DynamicResource AppFontFamily}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource TitleBarRowHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 背景层：中性底色 + 低对比的几何元素。
             这些元素存在的唯一目的是让「高斯模糊」可被肉眼感知——纯平/纯渐变的背景上，
             模糊半径 0 和 30 的渲染结果几乎一致，调节滑块就像没反应。
             这里只用中性灰阶，几何边缘在卡片内会被模糊、卡片外保持清晰，滑块变化因此可见。 -->
        <Grid x:Name="PART_Backdrop" Grid.RowSpan="2" Background="{DynamicResource WallpaperBrush}" ClipToBounds="True">
            <Ellipse Width="720" Height="720" Fill="{DynamicResource BackdropGlowBrush}" Opacity="0.60"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-220,0" />
            <Ellipse Width="560" Height="560" Fill="{DynamicResource BackdropTintBrush}" Opacity="0.55"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-180" />

            <!-- 点阵底纹（极淡）：卡片内的点会被模糊成柔和过渡，卡片外保持清晰，
                 拖动「高斯模糊强度」时能明显看出变化。 -->
            <Rectangle Fill="{DynamicResource DotGridBrush}" Opacity="0.75" />
        </Grid>

        <!-- ===== 应用顶栏（自绘标题栏） ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 品牌标记（母题：圆角矩形窗框 + 左上偏置光点，与 app.ico 同构）+ 标题 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="26,0,0,0" IsHitTestVisible="False">
                <Grid Width="20" Height="18" VerticalAlignment="Center">
                    <Border Width="17" Height="13" CornerRadius="3.5"
                            BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1.4"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextPrimaryBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0.5,0.5,0,0" />
                </Grid>
                <TextBlock Text="{DynamicResource App_Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeCaption}" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- 窗口三键：46×32，关闭键悬停浅红 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <local:SOrButton Style="{StaticResource CaptionButtonStyle}"
                                 Icon="{DynamicResource IconMinimize}"
                                 ToolTip="{DynamicResource Window_Minimize}"
                                 Command="{Binding WindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="Minimize" />
                <local:SOrButton Style="{StaticResource CaptionButtonStyle}"
                                 Icon="{DynamicResource IconMaximize}"
                                 ToolTip="{DynamicResource Window_Maximize}"
                                 Command="{Binding WindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="Maximize" />
                <local:SOrButton Style="{StaticResource CaptionCloseButtonStyle}"
                                 Icon="{DynamicResource IconClose}"
                                 ToolTip="{DynamicResource Common_Close}"
                                 Command="{Binding WindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="Close" />
            </StackPanel>
        </Grid>

        <!-- ===== 内容区 ===== -->
        <Grid x:Name="PART_Content" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <!-- 常规窗口留 22px 外距；最大化时收为 0，否则内容会离屏幕边缘空一圈 -->
                    <Setter Property="Margin" Value="22" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Margin" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏：磨砂卡片 + 导航（自定义 SOrCard / SOrButton） -->
            <local:SOrCard Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Stretch">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource App_Title}"
                               FontSize="{DynamicResource FontSizeBrand}" FontWeight="SemiBold" Margin="6,10,6,26" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                        <local:SOrButton Command="{Binding NavigateProjectsCommand}"
                                        Content="{DynamicResource Nav_Projects}"
                                        Icon="{DynamicResource IconList}"
                                        Variant="Nav"
                                        IsActive="{Binding ActiveNav, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Projects}"
                                        Margin="0,5" />
                        <local:SOrButton Command="{Binding NavigateNewCommand}"
                                        Content="{DynamicResource Nav_NewProject}"
                                        Icon="{DynamicResource IconPlus}"
                                        Variant="Nav"
                                        IsActive="{Binding ActiveNav, Converter={StaticResource StringEqualsConverter}, ConverterParameter=New}"
                                        Margin="0,5" />
                        <local:SOrButton Command="{Binding NavigateSettingsCommand}"
                                        Content="{DynamicResource Nav_Settings}"
                                        Icon="{DynamicResource IconSettings}"
                                        Variant="Nav"
                                        IsActive="{Binding ActiveNav, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Settings}"
                                        Margin="0,5" />
                    </StackPanel>

                    <!-- 最近立项（VD-082）：248×760 的侧边栏此前只有 3 个链接、其余全是空白。
                         这里补最近更新的 4 条，既是快捷入口，也让侧边栏承担信息而不只是导航。
                         标语已移到设置页「数据」分组，不再占这块最贵的面积。 -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,22,0,0"
                                Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Nav_Recent}" Margin="6,0,0,8"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:SOrButton Variant="Nav" Padding="10,7" Margin="0,2"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{Binding Name}"
                                                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionLine}"
                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="6,12,6,4" Opacity="0.8" />
                </DockPanel>
            </local:SOrCard>

            <!-- 内容区：承载当前视图（视图内部自行使用 SOrCard 磨砂卡片）。
                 与侧边栏同处一行、上下不留额外 margin，保证两张卡片顶边与底边严格对齐。 -->
            <Grid Grid.Column="1">
                <ContentControl x:Name="PART_ContentHost"
                                Content="{Binding CurrentView}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />

                <!--
                    更新提示条（VD-080）：改为浮层 toast，不再占一行布局。
                    旧版把提示条放在内容区上方一行——它一出现，整个页面下移、卡片高度重排，
                    用户在滚动/编辑时会看到页面「跳一下」，而这条提示本身是可以忽略的信息。
                    现在浮在内容右上角，进入时从上方 8px 落下并淡入，滚出视线也不影响布局。
                -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,4,0,0" Padding="14,10" Panel.ZIndex="20"
                        MaxWidth="440"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusMedium}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                          Color="{DynamicResource ColorShadow}" Opacity="0.20" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-8" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Updates.HasUpdate}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22"
                                                                 EasingFunction="{StaticResource CubicEaseOut}" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="-8" To="0" Duration="0:0:0.22"
                                                                 EasingFunction="{StaticResource CubicEaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <DockPanel LastChildFill="True">
                        <local:SOrButton DockPanel.Dock="Right"
                                        Content="{Binding Updates.BannerActionText}"
                                        Command="{Binding Updates.ShowCommand}"
                                        Variant="Secondary" Padding="12,6" Margin="12,0,0,0"
                                        FontSize="{DynamicResource FontSizeCaption}" />
                        <TextBlock Text="{Binding Updates.BannerText}"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium"
                                   FontSize="{DynamicResource FontSizeLabel}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 对话框覆盖层（规范 7.7 红线 #5：主窗口内承载，不用全透明窗口）
             入场：遮罩 180ms 淡入 + 内容弹入（PopIn）；出场：整体 140ms 淡出后卸载（VD-063） -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="50"
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDialogOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource CubicEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDialogClosing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource CubicEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{StaticResource ScrimBrush}">
                <Border.InputBindings>
                    <!-- VD-083：遮罩点击走独立命令——有输入的配置类弹窗不响应（误点即丢） -->
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ScrimCloseCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- 内容层：每次打开弹入（240ms + 0.96→1），不是「啪」地出现（VD-063）
                 VD-081：焦点陷阱——Tab / 方向键在弹窗内部循环，不再「穿过」遮罩跑到背后的导航上 -->
            <ContentControl x:Name="PART_DialogHost"
                            Content="{Binding DialogContent}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            KeyboardNavigation.TabNavigation="Cycle"
                            KeyboardNavigation.DirectionalNavigation="Cycle"
                            KeyboardNavigation.ControlTabNavigation="Cycle">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDialogOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PopInStoryboard}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
