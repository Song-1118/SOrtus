<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Sizes.xaml" />
    </ResourceDictionary.MergedDictionaries>



    <!--
        高斯模糊相关资源（规范 7.4.2 次选实现 / 7.5）：
        - 模糊效果只允许在此处与 Brushes.xaml 定义，其他样式文件不得重复定义同名模糊资源；
        - 页面内禁止出现内联 <BlurEffect>，一律通过资源键或 BlurPanel 附加属性使用；
        - 内核选型：静态面板用 Gaussian（自然过渡），动态/实时跟随用 Box + Performance。
    -->
    <BlurEffect x:Key="BlurEffectSubtle"
                Radius="{StaticResource BlurRadiusSubtle}"
                KernelType="Gaussian"
                RenderingBias="Performance" />
    <BlurEffect x:Key="BlurEffectNormal"
                Radius="{StaticResource BlurRadiusNormal}"
                KernelType="Gaussian"
                RenderingBias="Performance" />
    <BlurEffect x:Key="BlurEffectStrong"
                Radius="{StaticResource BlurRadiusStrong}"
                KernelType="Box"
                RenderingBias="Performance" />

</ResourceDictionary>
