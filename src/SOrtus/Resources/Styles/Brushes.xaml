<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        画刷层（规范 7.5）：所有主题相关色值一律通过 DynamicResource 引用主题字典，
        换肤时自动重新解析，无需重启。
        设计约束：不使用任何渐变与装饰光斑——背景为纯色，层次靠 Surface 底 + 1px Border 表达。
    -->

    <!-- 应用背景画刷（Window 背景、PART_Backdrop 与 BlurPanel 取样共用）。
         纯色，无渐变、无色球。x:Shared=False：每个引用获得独立实例。 -->
    <SolidColorBrush x:Key="WallpaperBrush" x:Shared="False" Color="{DynamicResource ColorBackgroundA}" />

    <!-- 兼容保留：早期版本用作「渐变 + 光斑」装饰视觉的宿主，现为纯色容器。
         BlurPanel 找不到 PART_Backdrop 时用它作为兜底取样源，键不可删。 -->
    <Grid x:Key="BackdropVisual" x:Shared="False" Background="{DynamicResource WallpaperBrush}" />

    <!-- 语义画刷 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource ColorPrimary}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource ColorSurface}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource ColorTextOnAccent}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource ColorBorder}" />
    <SolidColorBrush x:Key="AccentABrush" Color="{DynamicResource ColorAccentA}" />
    <SolidColorBrush x:Key="AccentBBrush" Color="{DynamicResource ColorAccentB}" />
    <SolidColorBrush x:Key="AccentCBrush" Color="{DynamicResource ColorAccentC}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource ColorDanger}" />
    <SolidColorBrush x:Key="ShadowBrush" Color="{DynamicResource ColorShadow}" />

    <!-- 高斯模糊覆盖层画刷：颜色随主题变化（浅色=白覆盖，深色=深灰覆盖），键名与两主题一一对应 -->
    <SolidColorBrush x:Key="BlurOverlayBrush" Color="{DynamicResource BlurOverlayColor}" />

    <!-- SOrTag 色调画刷（Tone → 背景/前景，随主题切换） -->
    <SolidColorBrush x:Key="TagAccentABgBrush" Color="{DynamicResource ColorTagAccentABg}" />
    <SolidColorBrush x:Key="TagAccentAFgBrush" Color="{DynamicResource ColorTagAccentAFg}" />
    <SolidColorBrush x:Key="TagAccentBBgBrush" Color="{DynamicResource ColorTagAccentBBg}" />
    <SolidColorBrush x:Key="TagAccentBFgBrush" Color="{DynamicResource ColorTagAccentBFg}" />
    <SolidColorBrush x:Key="TagAccentCBgBrush" Color="{DynamicResource ColorTagAccentCBg}" />
    <SolidColorBrush x:Key="TagAccentCFgBrush" Color="{DynamicResource ColorTagAccentCFg}" />
    <SolidColorBrush x:Key="TagSuccessBgBrush" Color="{DynamicResource ColorTagSuccessBg}" />
    <SolidColorBrush x:Key="TagSuccessFgBrush" Color="{DynamicResource ColorTagSuccessFg}" />
    <SolidColorBrush x:Key="TagWarningBgBrush" Color="{DynamicResource ColorTagWarningBg}" />
    <SolidColorBrush x:Key="TagWarningFgBrush" Color="{DynamicResource ColorTagWarningFg}" />
    <SolidColorBrush x:Key="TagDangerBgBrush" Color="{DynamicResource ColorTagDangerBg}" />
    <SolidColorBrush x:Key="TagDangerFgBrush" Color="{DynamicResource ColorTagDangerFg}" />
    <SolidColorBrush x:Key="TagNeutralBgBrush" Color="{DynamicResource ColorTagNeutralBg}" />
    <SolidColorBrush x:Key="TagNeutralFgBrush" Color="{DynamicResource ColorTagNeutralFg}" />

    <!-- 交互层画刷：悬浮 / 按压（自定义控件统一引用，便于后续挂动画） -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{DynamicResource ColorHoverOverlay}" />
    <SolidColorBrush x:Key="PressOverlayBrush" Color="{DynamicResource ColorPressOverlay}" />

    <!-- 导航 / 列表选中高亮画刷 -->
    <SolidColorBrush x:Key="NavActiveBrush" Color="{DynamicResource ColorNavActive}" />

    <!-- 滚动条滑块画刷 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ColorScrollThumb}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource ColorScrollThumbHover}" />

</ResourceDictionary>
