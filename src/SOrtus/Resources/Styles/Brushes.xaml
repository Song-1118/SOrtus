<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        画刷层（规范 7.5）：所有主题相关色值一律通过 DynamicResource 引用主题字典，
        换肤时自动重新解析，无需重启。
        设计约束：不使用任何渐变与装饰光斑——背景为纯色，层次靠 Surface 底 + 1px Border 表达。

        VD-061（P0）修复说明：
        此前只有 WallpaperBrush / BackdropGlow / BackdropTint / SoftShadow 带 x:Shared="False"，
        其余主题画刷（SurfaceBrush / TextPrimaryBrush / BorderBrush / …）是**单实例**资源。
        单实例 Freezable 在资源字典里会被 WPF 冻结（Freeze），而冻结会把
        Color="{DynamicResource ColorSurface}" 这个表达式就地求值成固定颜色——
        于是运行时替换主题字典后，SurfaceBrush 仍是上一套主题的白，而文字色（另一条路径）
        已经变了，得到「白卡 + 深底」这种在任何主题下都不成立的组合。
        修法：全部主题画刷加 x:Shared="False"，每次查找都新建实例，构造时重新求值 DynamicResource；
        配合 ThemeService 在换主题后对可视树逐属性 InvalidateProperty（重挂资源引用），
        已挂在控件上的画刷也会被重新取一次。
    -->

    <!--
        应用背景画刷：中性底色（Window 兜底背景）。真正的背景柔光由 MainWindow 的
        PART_Backdrop 图层承载——BlurPanel 直接对该图层做 1:1 取样，不经过 VisualBrush 缩放。
        颜色一律为中性灰阶，无任何彩色（禁用蓝紫渐变）。
    -->
    <SolidColorBrush x:Key="WallpaperBrush" x:Shared="False" Color="{DynamicResource ColorBackgroundA}" />

    <!-- 兼容保留：早期版本用作装饰视觉宿主；BlurPanel 找不到 PART_Backdrop 时的兜底取样源 -->
    <Grid x:Key="BackdropVisual" x:Shared="False" Background="{DynamicResource WallpaperBrush}" />

    <!--
        细网格底纹：2px 中性灰线、64px 网格（尺度做粗，保证 0→30 的每一档都能看出差别）。
        作用：给磨砂卡片提供**硬边缘**细节——模糊半径变大时网格会整体糊成柔和过渡，
        拖动「高斯模糊强度」时肉眼可见；圆点/色块要么太弱要么太抢，网格属于「有意的画布纹理」。
    -->
    <DrawingBrush x:Key="DotGridBrush" x:Shared="False" TileMode="Tile"
                  Viewport="0,0,64,64" ViewportUnits="Absolute"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{DynamicResource BackdropTintBrush}">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="0,0,64,2" />
                        <RectangleGeometry Rect="0,0,2,64" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 背景装饰画刷（跟随主题：浅色为白/浅灰，深色为略亮于底色的中性灰） -->
    <SolidColorBrush x:Key="BackdropGlowBrush" x:Shared="False" Color="{DynamicResource ColorBackdropGlow}" />
    <SolidColorBrush x:Key="BackdropTintBrush" x:Shared="False" Color="{DynamicResource ColorBackdropTint}" />

    <!-- 背景柔光用的中性灰（无彩色） -->
    <SolidColorBrush x:Key="SoftShadowBrush" x:Shared="False" Color="{DynamicResource ColorShadow}" />

    <!-- 语义画刷 -->
    <SolidColorBrush x:Key="PrimaryBrush" x:Shared="False" Color="{DynamicResource ColorPrimary}" />
    <!-- 键盘焦点环画刷（VD-059）：全站控件焦点视觉唯一取色处，深浅主题各自中间灰度。
         设置页「显示焦点框」关闭时，FocusRingSettings 把这一支覆盖为透明——
         单一开关点，不必在每个控件模板里各写一遍开关逻辑。 -->
    <SolidColorBrush x:Key="FocusRingBrush" x:Shared="False" Color="{DynamicResource ColorFocusRing}" />

    <!--
        品牌标记（母题「起源之光 · 立项之窗」）：
        窗框 = 主墨色，光点 = 次级灰。几何唯一来源是 outputs/brand/mark.json
        （矩形 20,26,60×48 r12 描边 7；圆 cx38 cy43 r9），XAML 侧按 100×100 画布等比复刻。
        深色主题不用「全白反白版」：框与点同为白色时，点在 24px 下会与框角糊成一团，
        因此深色沿用「框亮、点暗」的同一层级关系（反白纯白版仍用于印刷与图标文件）。
    -->
    <SolidColorBrush x:Key="BrandMarkFrameBrush" x:Shared="False" Color="{DynamicResource ColorBrandMarkFrame}" />
    <SolidColorBrush x:Key="BrandMarkDotBrush" x:Shared="False" Color="{DynamicResource ColorBrandMarkDot}" />

    <SolidColorBrush x:Key="SurfaceBrush" x:Shared="False" Color="{DynamicResource ColorSurface}" />
    <!-- 卡内分组卡底色（VD-077）：比 Surface 低/高一阶，卡片套卡片才有明暗差 -->
    <SolidColorBrush x:Key="SurfaceAltBrush" x:Shared="False" Color="{DynamicResource ColorSurfaceAlt}" />
    <!-- 输入类控件填充（VD-073）：与卡片分层，配合 BorderStrongBrush 让可编辑区域成立 -->
    <SolidColorBrush x:Key="InputSurfaceBrush" x:Shared="False" Color="{DynamicResource ColorInputSurface}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" x:Shared="False" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" x:Shared="False" Color="{DynamicResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" x:Shared="False" Color="{DynamicResource ColorTextOnAccent}" />
    <SolidColorBrush x:Key="BorderBrush" x:Shared="False" Color="{DynamicResource ColorBorder}" />
    <!-- 控件边界画刷（VD-073）：≥3:1，只用于输入框/下拉框/日期框这类「可编辑区域」的描边 -->
    <SolidColorBrush x:Key="BorderStrongBrush" x:Shared="False" Color="{DynamicResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="AccentABrush" x:Shared="False" Color="{DynamicResource ColorAccentA}" />
    <SolidColorBrush x:Key="AccentBBrush" x:Shared="False" Color="{DynamicResource ColorAccentB}" />
    <SolidColorBrush x:Key="AccentCBrush" x:Shared="False" Color="{DynamicResource ColorAccentC}" />
    <SolidColorBrush x:Key="SuccessBrush" x:Shared="False" Color="{DynamicResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" x:Shared="False" Color="{DynamicResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" x:Shared="False" Color="{DynamicResource ColorDanger}" />
    <SolidColorBrush x:Key="ShadowBrush" x:Shared="False" Color="{DynamicResource ColorShadow}" />

    <!-- 高斯模糊覆盖层画刷：颜色随主题变化（浅色=白覆盖，深色=深灰覆盖），键名与两主题一一对应 -->
    <SolidColorBrush x:Key="BlurOverlayBrush" x:Shared="False" Color="{DynamicResource BlurOverlayColor}" />

    <!-- SOrTag 色调画刷（Tone → 背景/前景，随主题切换） -->
    <SolidColorBrush x:Key="TagAccentABgBrush" x:Shared="False" Color="{DynamicResource ColorTagAccentABg}" />
    <SolidColorBrush x:Key="TagAccentAFgBrush" x:Shared="False" Color="{DynamicResource ColorTagAccentAFg}" />
    <SolidColorBrush x:Key="TagAccentBBgBrush" x:Shared="False" Color="{DynamicResource ColorTagAccentBBg}" />
    <SolidColorBrush x:Key="TagAccentBFgBrush" x:Shared="False" Color="{DynamicResource ColorTagAccentBFg}" />
    <SolidColorBrush x:Key="TagAccentCBgBrush" x:Shared="False" Color="{DynamicResource ColorTagAccentCBg}" />
    <SolidColorBrush x:Key="TagAccentCFgBrush" x:Shared="False" Color="{DynamicResource ColorTagAccentCFg}" />
    <SolidColorBrush x:Key="TagSuccessBgBrush" x:Shared="False" Color="{DynamicResource ColorTagSuccessBg}" />
    <SolidColorBrush x:Key="TagSuccessFgBrush" x:Shared="False" Color="{DynamicResource ColorTagSuccessFg}" />
    <SolidColorBrush x:Key="TagWarningBgBrush" x:Shared="False" Color="{DynamicResource ColorTagWarningBg}" />
    <SolidColorBrush x:Key="TagWarningFgBrush" x:Shared="False" Color="{DynamicResource ColorTagWarningFg}" />
    <SolidColorBrush x:Key="TagDangerBgBrush" x:Shared="False" Color="{DynamicResource ColorTagDangerBg}" />
    <SolidColorBrush x:Key="TagDangerFgBrush" x:Shared="False" Color="{DynamicResource ColorTagDangerFg}" />
    <SolidColorBrush x:Key="TagNeutralBgBrush" x:Shared="False" Color="{DynamicResource ColorTagNeutralBg}" />
    <SolidColorBrush x:Key="TagNeutralFgBrush" x:Shared="False" Color="{DynamicResource ColorTagNeutralFg}" />
    <!-- 中性标签描边（VD-074）：中性 Tag 改描边式，容器形状才可辨 -->
    <SolidColorBrush x:Key="TagNeutralBorderBrush" x:Shared="False" Color="{DynamicResource ColorTagNeutralBorder}" />

    <!-- 交互层画刷：悬浮 / 按压（自定义控件统一引用，便于后续挂动画） -->
    <SolidColorBrush x:Key="HoverOverlayBrush" x:Shared="False" Color="{DynamicResource ColorHoverOverlay}" />
    <SolidColorBrush x:Key="PressOverlayBrush" x:Shared="False" Color="{DynamicResource ColorPressOverlay}" />

    <!-- 导航 / 列表选中高亮画刷 -->
    <SolidColorBrush x:Key="NavActiveBrush" x:Shared="False" Color="{DynamicResource ColorNavActive}" />

    <!-- 滑块底轨画刷：比「填充色」浅但比分隔线深，保证左右两段视觉粗细一致 -->
    <SolidColorBrush x:Key="SliderTrackBrush" x:Shared="False" Color="{DynamicResource ColorSliderTrack}" />

    <!-- 滚动条滑块画刷（VD-072：≥3:1） -->
    <SolidColorBrush x:Key="ScrollThumbBrush" x:Shared="False" Color="{DynamicResource ColorScrollThumb}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" x:Shared="False" Color="{DynamicResource ColorScrollThumbHover}" />

</ResourceDictionary>
