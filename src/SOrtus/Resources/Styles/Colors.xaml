<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        共享色板（与主题无关，浅色/深色一致）。
        主题相关的文本/表面/强调/覆盖色在 Themes/Light.xaml 与 Dark.xaml 中按键一一对应定义。
    -->

    <!-- 状态色（规范 6/7：语义化、跨主题一致） -->
    <Color x:Key="ColorSuccess">#16A34A</Color>
    <Color x:Key="ColorWarning">#D97706</Color>
    <Color x:Key="ColorDanger">#DC2626</Color>
    <Color x:Key="ColorInfo">#2563EB</Color>

</ResourceDictionary>
