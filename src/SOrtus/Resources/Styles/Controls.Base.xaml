<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- 动画节奏单点定义（VD-062/064）：本字典模板里引用 MicroIn/MicroOut/Press*/FocusRing* 等 Storyboard，
             StaticResource 只在本字典及其 MergedDictionaries 内可见，故显式声明依赖 -->
        <ResourceDictionary Source="Animations.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        基础控件样式（规范 7.6）：圆角、主题色、字体统一收敛到全局资源，避免页面内联覆盖。
        注意：交互控件（按钮 / 输入框 / 下拉框 / 日期选择器 / 滑块）已全部自定义
        （SOrButton / SOrTextBox / SOrComboBox / SOrDatePicker / SOrSlider，见 Controls.*.xaml），
        此处不再定义原生 Button / TextBox 隐式样式，防止两套视觉并存。
    -->

    <!--
        全局文本默认字体。
        注意：这里**不设置** Foreground —— WPF 中样式 Setter 的优先级高于属性继承，
        一旦在此写死前景色，按钮（深底白字）、标签（色调色）、对话框等内容文字都会被染成
        统一的正文色，导致「深底 + 深字」看不见。默认前景改由视觉树根部继承
        （MainWindow 的 TextElement.Foreground = TextPrimaryBrush），主题切换仍然生效。
    -->
    <Style TargetType="TextBlock">
        <!-- VD-076 / 旧单 VD-003：中文优先、拉丁回退。
             旧值 "Segoe UI, Microsoft YaHei, PingFang SC, sans-serif" 让 CJK 落到第二顺位，
             中英混排（"65% 完成"、"a1b2c3d 提交"）行内出现粗细断层；
             末尾 sans-serif 在 WPF 不是有效字体名，兜底无效。字族统一收敛到 AppFontFamily 令牌。 -->
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <!-- 不在这里设置 TextTrimming：全局省略号会把「应当换行」的说明文字也截断，
             需要省略号的场景（列表项名称 / 详情标题）由各自模板显式声明。 -->
    </Style>

    <!-- 列表背景透明，避免遮挡磨砂卡片 -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!--
        列表项容器：透明底 + 自定义悬浮 / 选中视觉（PART_Hover 为动画挂点）。
        HorizontalContentAlignment=Stretch 保证自定义行组件（SOrProjectListItem）铺满整行。
    -->
    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <!-- 选中层与悬浮层分离（VD-064 遗留风险）：
                             悬浮改用 Storyboard 驱动 Opacity 之后，若选中态仍复用同一层，
                             鼠标移出时「淡出到 0」的动画会压过选中的 Setter，
                             选中项一移开鼠标就失去高亮。这里选中用独立层、只走 Setter。 -->
                        <Border x:Name="PART_Selected"
                                Background="{DynamicResource NavActiveBrush}"
                                CornerRadius="{DynamicResource CornerRadiusMedium}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PART_Hover"
                                Background="{DynamicResource HoverOverlayBrush}"
                                CornerRadius="{DynamicResource CornerRadiusMedium}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                        <!-- 键盘焦点环（VD-059）：Tab 在列表内移动时标识当前项；1px FocusRingBrush 内描边；
                             选中态另有高亮底，可叠加 -->
                        <Border x:Name="PART_FocusRing"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="1"
                                Margin="0"
                                CornerRadius="{DynamicResource CornerRadiusMedium}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- VD-064：列表项悬浮与按钮共用同一套微交互节奏（120ms 进 / 160ms 出） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_Selected" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        滚动条：细轨 + 胶囊滑块，悬浮加深（命名层：PART_Track 为原生约定，
        Track 自动从模板父级绑定 Value / ViewportSize，XAML 中不得显式设置）。
    -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- 圆角矩形滑块（不用 Pill：细条上 Pill 会被渲染成椭圆端头） -->
                                            <Border x:Name="PART_Thumb"
                                                    Background="{DynamicResource ScrollThumbBrush}"
                                                    CornerRadius="{DynamicResource CornerRadiusThumb}"
                                                    Margin="3,2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        复选框：WPF 默认模板在深色主题下仍是白底黑框（深色模式里会突兀成「白块」），
        这里统一成主题化圆角方块 + 主色勾，全局生效（文档待办、对话框选项共用）。
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!-- 命中区（VD-015）：24×24 透明边框包住 14×14 方框，达到可访问性最小可点尺寸，
                             点击空白处亦可切换；同时兼任键盘焦点环——获焦时 2px Primary 描边（VD-010），
                             方框固定 14×14 居中，描边不挤压内容、不产生位移 -->
                        <Border x:Name="PART_HitArea" MinWidth="24" MinHeight="24"
                                Background="Transparent" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource CornerRadiusBar}">
                            <Border x:Name="PART_Box" Width="14" Height="14"
                                    CornerRadius="{DynamicResource CornerRadiusBar}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.25"
                                    VerticalAlignment="Center">
                                <Path x:Name="PART_Check" Width="10" Height="10" Stretch="Uniform"
                                      Data="M 3,8.5 L 6.5,12 L 13,4"
                                      Stroke="{DynamicResource PrimaryBrush}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <!-- 键盘聚焦：命中区描边 2px 形成焦点环（VD-010；方框居中，不位移） -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_HitArea" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 提示气泡：默认模板是白底黑字，深色主题下同样会「漏白」 -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                            Padding="8,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
