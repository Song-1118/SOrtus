<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SOrtus.Controls"
                    xmlns:conv="clr-namespace:SOrtus.Converters">

    <ResourceDictionary.MergedDictionaries>
        <!-- 动画节奏单点定义（VD-062/064）：本字典模板里引用 MicroIn/MicroOut/Press*/FocusRing* 等 Storyboard，
             StaticResource 只在本字典及其 MergedDictionaries 内可见，故显式声明依赖 -->
        <ResourceDictionary Source="Animations.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        SOrButton 样式（规范 7.1「样式先集中、控件再复用」）。
        视觉变体 Primary / Secondary / Danger / Ghost / Nav 由 Style 触发器切换背景前景，
        模板只负责结构：PART_Root（背景）+ PART_Hover（悬浮覆盖）+ PART_Press（按压覆盖）
        + PART_FocusRing（键盘焦点环）+ 图标 + 内容。
        后期做空间模糊（对 PART_Root 挂 BlurPanel）与动画（驱动覆盖层 Opacity）均无需改控件代码。
    -->
    <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />

    <Style TargetType="local:SOrButton">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <!-- 全局默认 SemiBold：主按钮 / 关键操作（VD-002 三档字重中 SemiBold 的许可用途） -->
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <!-- 默认水平居中：Control 的 HorizontalContentAlignment 默认是 Left，
             按钮被 Grid 拉伸时内容会贴左（用户报「创建/下一步/刷新/叉号不居中」） -->
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- 自定义焦点环接管键盘焦点视觉 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrButton">
                    <Grid>
                        <!-- VD-065：按压时 PART_Root 缩到 0.98（RenderTransform，不影响布局）。
                             RenderTransformOrigin 居中，缩放看起来是「按下去」而不是「往左上跑」。 -->
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <!-- 悬浮 / 按压覆盖层：默认透明，触发器以动画驱动 Opacity -->
                                <Border x:Name="PART_Hover"
                                        Background="{DynamicResource HoverOverlayBrush}"
                                        Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False" />
                                <Border x:Name="PART_Press"
                                        Background="{DynamicResource PressOverlayBrush}"
                                        Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False" />
                                <!-- 图标 + 文字作为一个整体居中：图标不单独占列，间距固定 8px，
                                     Icon 为空时 Path 折叠不占位（修复 + 号贴左 / 与文字错位） -->
                                <!-- 图标列自适应、内容列吃满剩余宽度：按钮被拉伸时（如向导三张类型卡）
                                     内容才能拿到确定的可用宽度并正确换行；按钮自适应宽度时该列等于内容宽度，
                                     图标与文字仍作为一个整体居中。 -->
                                <!-- 图标与文字作为整体居中（硬编码 Center：
                                     TemplateBinding HorizontalContentAlignment 实测传不过来，
                                     StackPanel 回落 Stretch 导致内容贴左）。
                                     类型卡（Variant=Card）的内容是垂直流，不依赖水平铺满，
                                     因此这里不需要跟随 HorizontalContentAlignment 变化。 -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            HorizontalAlignment="Center"
                                            Margin="{TemplateBinding Padding}">
                                    <!--
                                        图标按钮（只有图标、没有文字）此前图标独占 Auto 列，
                                        右侧 * 列空着 → 图标贴在按钮左侧而不是居中。
                                        这里在「内容为空」时让图标跨两列，整颗按钮水平居中。
                                    -->
                                    <Path x:Name="PART_Icon"
                                          Data="{TemplateBinding Icon}"
                                          Fill="{TemplateBinding Foreground}"
                                          Width="{TemplateBinding IconSize}"
                                          Height="{TemplateBinding IconSize}"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Visibility="{Binding Icon, Converter={StaticResource NotNullToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                                    </Path>
                                    <!-- 图标与文字同处一个水平容器：整体居中，不再「图标贴左 + 文字另居」 -->
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 键盘焦点环（VD-059）：默认透明，仅 IsKeyboardFocusWithin 时显示；
                             1px FocusRingBrush 内描边（Margin=0，绘制在按钮边界之内，不向外投影），
                             避免旧版 2px 近白实心外扩环在磨砂卡片上过于抢眼；
                             鼠标点击不触发（用 IsKeyboardFocusWithin 而非 IsFocus）；
                             FocusVisualStyle 已置空，系统默认虚线框不显示，焦点视觉由本环接管 -->
                        <Border x:Name="PART_FocusRing"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="1"
                                Margin="0"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- 类型卡选中环（VD-093）：2px 主色描边单独一层，避免把 BorderThickness
                             从 1 改到 2 时内容整体位移 1px -->
                        <Border x:Name="PART_ActiveRing"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- 类型卡选中角标（VD-093）：右上角对勾，选中不再只靠边框深浅 -->
                        <Border x:Name="PART_Check"
                                Width="18" Height="18" CornerRadius="9"
                                Background="{DynamicResource PrimaryBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,9,9,0" Opacity="0" IsHitTestVisible="False">
                            <Path Data="{DynamicResource IconCheck}"
                                  Fill="{DynamicResource TextOnAccentBrush}"
                                  Width="9" Height="9" Stretch="Uniform" />
                        </Border>
                        <!-- 版块 tab 指示条（VD-100）：底部 2px，200ms 从中间展开 -->
                        <Border x:Name="PART_TabIndicator"
                                Height="2"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource PrimaryBrush}"
                                RenderTransformOrigin="0.5,0.5"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.6" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 悬浮：引用 Animations.xaml 的 MicroIn/MicroOut（120ms 进 / 160ms 出，CubicEaseOut）。
                             VD-064：不再在模板内联 120ms 线性 / 180ms 的两套私有节奏。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 按压：蒙层 + 0.98 缩放（VD-065：旧版 80ms 只改蒙层，按了像没按） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource PressInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource PressOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 键盘聚焦：焦点环 100ms 淡入、离开立即消失（VD-066：旧版一帧硬切，像一次闪烁） -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 规范调整：全局不显示键盘聚焦框（FocusVisualStyle 亦置空），避免点击后残留描边 -->
                        <!-- M-18 进入禁用：1→0.45，120ms Std（Setter 保底，动画跟随状态） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.45" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource DisableFadeStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource EnableFadeStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- hover 保底（VD-125）：非悬停态显式把覆盖层 Opacity 归零。
                             只靠 MicroOut 动画不够——HoldEnd 动画在元素复用 / 状态快速
                             翻转等路径下可能把 Opacity 遗留在 1，鼠标划过后留下一层
                             悬停背景（用户报「标签栏滑过导致背景遗留」）。 -->
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="PART_Hover" Property="Opacity" Value="0" />
                            <Setter TargetName="PART_Press" Property="Opacity" Value="0" />
                        </Trigger>
                        <!-- 类型卡选中（VD-093）：2px 主色环 + 右上角对勾 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="Card" />
                                <Condition Property="IsActive" Value="True" />
                            </MultiTrigger.Conditions>
                            <!-- Setter 保底（触发首次激活若未跑动画，选中态也不会丢）+ 160ms 淡入 -->
                            <Setter TargetName="PART_ActiveRing" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_Check" Property="Opacity" Value="1" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource CardActiveInStoryboard}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource CardActiveOutStoryboard}" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!-- 版块 tab 选中（VD-100）：底部 2px 指示条 200ms 展开 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="Tab" />
                                <Condition Property="IsActive" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource TabIndicatorInStoryboard}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource TabIndicatorOutStoryboard}" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- 次要：Surface 底 + 描边 -->
            <Trigger Property="Variant" Value="Secondary">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
            <!--
                危险：软危险样式（VD-075）。
                旧版是整屏唯一的高饱和实心 #DC2626，与文档错误条的暗红 #B42318 一族两色，
                一出现就把整屏的中性克制感打破。现在按钮只保留「浅底 + 深字 + 同色描边」，
                与标签、错误文案共用同一套语义色；实心红留给二次确认里的最终动作（后续单独引入）。
            -->
            <Trigger Property="Variant" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource TagDangerBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TagDangerFgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TagDangerFgBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
            <!--
                破坏性最终动作（VD-117）：只出现在二次确认弹窗里。
                实心危险底 + 反色文字；与页面内软危险按钮不同重量，用户不会把它当成普通按钮顺手下按。
            -->
            <!-- M-43：背景色交给 SOrButton.IsDestructive 的 120ms ColorAnimation（代码侧），
                 这里不再 Setter Background——硬切会把颜色过渡顶掉；前景/描边仍由 Setter 兜底。 -->
            <Trigger Property="IsDestructive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
            <!-- 幽灵：透明底，低强调动作 -->
            <Trigger Property="Variant" Value="Ghost">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,8" />
            </Trigger>
            <!-- 导航：透明底 + 左对齐 -->
            <Trigger Property="Variant" Value="Nav">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="Medium" />
            </Trigger>
            <!-- 导航 + 当前态：高亮底（规范 7.6 导航高亮） -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="Nav" />
                    <Condition Property="IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </MultiTrigger>
            <!-- 其它变体的选中态（类型卡片 / 技术栈预设 chip）：高亮底 + 主色描边 -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="Secondary" />
                    <Condition Property="IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </MultiTrigger>

            <!--
                类型卡（VD-093）：向导第 1 步的三张卡。
                旧版用 Secondary，未选中时与背景几乎同色（只有 1px 浅边），选中只是把边变白一点，
                三张卡看起来像「一张有框、两张没框」。这里：未选中 = 低一阶底色 + 明确边框，
                选中 = 2px 主色环 + 右上角对勾 + 底色提亮（环与角标由模板里的命名层表达）。
            -->
            <Trigger Property="Variant" Value="Card">
                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="Card" />
                    <Condition Property="IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </MultiTrigger>

            <!--
                版块 tab（VD-100）：详情页「基础/开发/GIT」三个切换。
                旧版直接用 Nav 变体——未选中无边框无下划线、选中是灰底块，看起来是三个标签而不是可切换 tab。
                现在：未选中次要色文字 + hover 浅底，选中主色文字 + 底部 2px 指示条（200ms 展开）。
            -->
            <Trigger Property="Variant" Value="Tab">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="Tab" />
                    <Condition Property="IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--
        窗口三键（VD-060）：最小化 / 最大化还原 / 关闭。
        34×30 圆角 6 的 Ghost 变体，图标 12px；关闭键悬停给浅红底——这是全站唯一
        允许出现的「危险色悬停」，因为它是系统级动作、且只在指针下停留时出现。
    -->
    <!--
        注意：SOrButton 的模板来自隐式样式（无 generic.xaml），任何 keyed 样式都必须 BasedOn 它，
        否则 Style 会顶掉隐式样式 → 控件没有 Template → 渲染为空（窗口三键「消失」就是这么来的）。
    -->
    <!--
        保存按钮反馈（M-46 / M-47）：定义在控件字典里而不是页面内联 Style。
        原因：自定义控件的模板只存在于隐式样式，页面里写 <Style TargetType="local:SOrButton">
        会顶掉隐式样式导致按钮无模板（整颗不可见）；而 BasedOn="{StaticResource {x:Type local:SOrButton}}"
        在 ViewTemplates 字典内又找不到（Controls.Button.xaml 不在其可见范围）。
        正确做法就是在这里定义 keyed 样式，并让 ViewTemplates 合并本字典。
    -->
    <Style x:Key="SaveFeedbackButtonStyle" TargetType="local:SOrButton"
           BasedOn="{StaticResource {x:Type local:SOrButton}}">
        <Style.Triggers>
            <!-- M-47 保存中：1→0.7，120ms Std（禁用点击但保持可读，不加旋转 loading） -->
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Opacity" Value="0.7" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SavingDimStoryboard}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <!-- M-46 保存成功回执：180ms 淡入 → 停 2.5s → 240ms 淡出 -->
            <DataTrigger Binding="{Binding IsJustSaved}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SaveStatusInStoryboard}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SaveStatusOutStoryboard}" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="local:SOrButton"
           BasedOn="{StaticResource {x:Type local:SOrButton}}">
        <Setter Property="Variant" Value="Ghost" />
        <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}" />
        <Setter Property="Height" Value="{DynamicResource CaptionButtonHeight}" />
        <Setter Property="IconSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CaptionCloseButtonStyle" TargetType="local:SOrButton" BasedOn="{StaticResource CaptionButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TagDangerBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TagDangerFgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
