<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SOrtus.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Card.xaml" />
    </ResourceDictionary.MergedDictionaries>



    <!--
        对话框 / 浮层样式（规范 7.4.1 / 7.7 红线 #5）：
        主窗口内覆盖层承载对话框（不用 AllowsTransparency 全透明窗口），
        对话框本体为磨砂卡片（更强模糊）。
    -->

    <!-- 覆盖层遮罩：压暗整个窗口，突出对话框 -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />

    <!-- 浮层 / 弹窗样式：在磨砂卡片基础上使用更强模糊 -->
    <!--
        弹窗观感收敛（用户反馈「弹窗光晕太严重」）：
        模糊半径 20 → 10（强模糊会把背后内容糊成大片色块，视觉上就是「光晕」；
        10 仍能看出「背后有内容但读不了」，又不抢弹窗本身）；
        覆盖层 0.9 → 0.96（底色更实，正文不再透出来糊在文字上）。
    -->
    <Style x:Key="BlurDialogStyle" TargetType="Border" BasedOn="{StaticResource BlurCardStyle}">
        <Setter Property="local:BlurPanel.BlurRadius" Value="10" />
        <!-- 弹窗需要「压住」背后的页面：覆盖层更实，避免正文透出来糊在文字上 -->
        <Setter Property="local:BlurPanel.OverlayOpacity" Value="0.96" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

</ResourceDictionary>
