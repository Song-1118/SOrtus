<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SOrtus.Controls"
                    xmlns:conv="clr-namespace:SOrtus.Converters">

    <ResourceDictionary.MergedDictionaries>
        <!-- 动画节奏单点定义（VD-062/064）：本字典模板里引用 MicroIn/MicroOut/Press*/FocusRing* 等 Storyboard，
             StaticResource 只在本字典及其 MergedDictionaries 内可见，故显式声明依赖 -->
        <ResourceDictionary Source="Animations.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        展示类自定义控件样式（规范 7.1）：SOrTag / SOrProgressBar / SOrProjectListItem。
        色调、语义一律由控件属性声明（Tone / Variant），禁止页面内联覆盖颜色。
    -->
    <conv:ProjectTypeDisplayConverter x:Key="ProjectTypeDisplayConverter" />
    <conv:ProjectStatusDisplayConverter x:Key="ProjectStatusDisplayConverter" />
    <conv:ProjectTypeToToneConverter x:Key="ProjectTypeToToneConverter" />
    <conv:ProjectStatusToToneConverter x:Key="ProjectStatusToToneConverter" />
    <conv:UpdatedAtDisplayConverter x:Key="UpdatedAtDisplayConverter" />

    <!-- ============================ SOrTag ============================ -->
    <Style TargetType="local:SOrTag">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrTag">
                    <!-- VD-074：中性 / 强调类标签改「填充 + 1px 描边」。
                         旧版底色#F3F4F6 对白卡只有 1.10:1，胶囊退化成一行散字，
                         GIT 分支、MD 徽标、技术栈三处完全看不出是「标签」；
                         补描边后容器形状可辨，色相留给语义（成功/警告/危险）。 -->
                    <Border x:Name="PART_Root"
                            Background="{DynamicResource TagNeutralBgBrush}"
                            BorderBrush="{DynamicResource TagNeutralBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource TagNeutralFgBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tone" Value="AccentA">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource TagAccentABgBrush}" />
                            <Setter TargetName="PART_Root" Property="TextElement.Foreground" Value="{DynamicResource TagAccentAFgBrush}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="AccentB">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource TagAccentBBgBrush}" />
                            <Setter TargetName="PART_Root" Property="TextElement.Foreground" Value="{DynamicResource TagAccentBFgBrush}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="AccentC">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource TagAccentCBgBrush}" />
                            <Setter TargetName="PART_Root" Property="TextElement.Foreground" Value="{DynamicResource TagAccentCFgBrush}" />
                        </Trigger>
                        <!-- 语义色本身已有色相区分，不再描边（描边会把「软」的语义标签变成硬框） -->
                        <Trigger Property="Tone" Value="Success">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource TagSuccessBgBrush}" />
                            <Setter TargetName="PART_Root" Property="TextElement.Foreground" Value="{DynamicResource TagSuccessFgBrush}" />
                            <Setter TargetName="PART_Root" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Warning">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource TagWarningBgBrush}" />
                            <Setter TargetName="PART_Root" Property="TextElement.Foreground" Value="{DynamicResource TagWarningFgBrush}" />
                            <Setter TargetName="PART_Root" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Danger">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource TagDangerBgBrush}" />
                            <Setter TargetName="PART_Root" Property="TextElement.Foreground" Value="{DynamicResource TagDangerFgBrush}" />
                            <Setter TargetName="PART_Root" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Neutral">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource TagNeutralBgBrush}" />
                            <Setter TargetName="PART_Root" Property="TextElement.Foreground" Value="{DynamicResource TagNeutralFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SOrProgressBar ============================ -->
    <Style TargetType="local:SOrProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusBar}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrProgressBar">
                    <!-- 命名层：PART_Root（轨道，代码按 TrackBrush/BorderBrush 回填背景）、PART_Fill（填充，代码动画 Width） -->
                    <Border x:Name="PART_Root"
                            Background="{DynamicResource BorderBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="PART_Fill"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SOrProjectListItem ============================ -->
    <Style TargetType="local:SOrProjectListItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrProjectListItem">
                    <Grid>
                        <Border x:Name="PART_Root"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusMedium}"
                                Padding="14,10"
                                Cursor="Hand"
                                ToolTip="{DynamicResource List_OpenHint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 名称 + 更新时间 -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Project.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="{DynamicResource FontSizeSection}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Project.UpdatedAt, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpdatedAtDisplayConverter}}"
                                               FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <!-- 类型 / 状态胶囊 -->
                                <local:SOrTag Grid.Column="1" Margin="0,0,8,0"
                                              Tone="{Binding Project.Type, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ProjectTypeToToneConverter}}">
                                    <TextBlock Text="{Binding Project.Type, RelativeSource={RelativeSource AncestorType=local:SOrProjectListItem}, Converter={StaticResource ProjectTypeDisplayConverter}}"
                                               FontSize="{DynamicResource FontSizeCaption}" />
                                </local:SOrTag>
                                <local:SOrTag Grid.Column="2" Margin="0,0,12,0"
                                              Tone="{Binding Project.Status, RelativeSource={RelativeSource AncestorType=local:SOrProjectListItem}, Converter={StaticResource ProjectStatusToToneConverter}}">
                                    <TextBlock Text="{Binding Project.Status, RelativeSource={RelativeSource AncestorType=local:SOrProjectListItem}, Converter={StaticResource ProjectStatusDisplayConverter}}"
                                               FontSize="{DynamicResource FontSizeCaption}" />
                                </local:SOrTag>
                                <!-- 进度条 + 百分比（VD-088）：72px 细条在 8 档之间的长度差只有 9px，
                                     没有数字只能靠猜；补一个 12px 的读数，与详情页的「65%」同精度 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,14,0">
                                    <local:SOrProgressBar Width="72" VerticalAlignment="Center"
                                                          Value="{Binding Project.ProgressPercent, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TextBlock Width="38" Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Project.ProgressPercent, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}" />
                                </StackPanel>
                                <!-- 打开按钮 -->
                                <local:SOrButton Grid.Column="4" Variant="Secondary"
                                                 Content="{DynamicResource List_Open}"
                                                 Command="{Binding OpenCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                 CommandParameter="{Binding Project, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Border>
                        <!-- 悬浮覆盖层（动画挂点：改 Opacity 即得平滑过渡） -->
                        <Border x:Name="PART_Hover"
                                Background="{DynamicResource HoverOverlayBrush}"
                                CornerRadius="{DynamicResource CornerRadiusMedium}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- 键盘焦点环（VD-059）：列表项可获焦，Tab 移动时标识当前项；1px FocusRingBrush 内描边 -->
                        <Border x:Name="PART_FocusRing"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="1"
                                Margin="0"
                                CornerRadius="{DynamicResource CornerRadiusMedium}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- VD-064：与按钮共用同一套微交互节奏（120ms 进 / 160ms 出，CubicEaseOut） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- VD-066：焦点环 100ms 淡入、离开立即消失 -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
