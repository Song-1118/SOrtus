<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SOrtus.Controls"
                    xmlns:conv="clr-namespace:SOrtus.Converters">

    <ResourceDictionary.MergedDictionaries>
        <!-- 动画节奏单点定义（VD-062/064）：本字典模板里引用 MicroIn/MicroOut/Press*/FocusRing* 等 Storyboard，
             StaticResource 只在本字典及其 MergedDictionaries 内可见，故显式声明依赖 -->
        <ResourceDictionary Source="Animations.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        输入类自定义控件样式（规范 7.1）：SOrTextBox / SOrComboBox / SOrDatePicker / SOrSlider。
        每个控件的视觉树都内置命名层（PART_Root / PART_Hover / PART_FocusRing / PART_Placeholder 等），
        后期做空间模糊（对 PART_Root 挂 BlurPanel）与动画（驱动覆盖层 Opacity）均无需改控件代码。
        日期选择器的下拉日历样式（SOrCalendar*）同样在此集中定义。
    -->
    <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
    <conv:NotMonthModeConverter x:Key="NotMonthModeConverter" />

    <!-- ============================ SOrTextBox ============================ -->
    <!--
        SOrTextBox（外壳 + 内嵌原生 TextBox）：
        内部输入框用**系统模板**（不换模板），光标定位 / 输入 / 选中 / IME 全部走 WPF 原生实现；
        外壳负责边框、填充、前置图标、占位符、清除按钮与校验态外观。
        占位符与焦点环的触发条件都指向内部输入框（ElementName=PART_ContentHost），
        因为焦点与文本都在它身上。
    -->
    <Style TargetType="local:SOrTextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- VD-073：输入框填充比卡片低一阶 + 边界 ≥3:1（BorderStrongBrush） -->
        <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrTextBox">
                    <Grid>
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 悬浮覆盖层（VD-011）：鼠标划过仅叠一层 HoverOverlayBrush 弱底色、不改描边 -->
                                <Border x:Name="PART_Hover"
                                        Background="{DynamicResource HoverOverlayBrush}"
                                        Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False" />
                                <Border x:Name="PART_Inset" Padding="{DynamicResource InputInsetHorizontal}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 前置图标（LeadingIcon 为空时自动折叠，不占位） -->
                                        <Path Grid.Column="0"
                                              Data="{TemplateBinding LeadingIcon}"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              Width="{TemplateBinding IconSize}"
                                              Height="{TemplateBinding IconSize}"
                                              Stretch="Uniform"
                                              Margin="{DynamicResource IconGap}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Visibility="{Binding LeadingIcon, Converter={StaticResource NotNullToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" />

                                        <!-- 内部原生输入框：系统模板负责编辑区与光标，这里只调外观 -->
                                        <TextBox x:Name="PART_ContentHost"
                                                 Grid.Column="1"
                                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="{Binding AcceptsReturn, RelativeSource={RelativeSource TemplatedParent}}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 CaretBrush="{TemplateBinding CaretBrush}"
                                                 SelectionBrush="{TemplateBinding SelectionBrush}"
                                                 TextWrapping="{TemplateBinding TextWrapping}"
                                                 FontSize="{TemplateBinding FontSize}"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center" />

                                        <!-- 占位符：与真实文本共用同一列与同一起点，保证左对齐一致。
                                             M-21：显隐用 Opacity（0 ↔ 0.85，100ms），不用 Collapsed -->
                                        <TextBlock x:Name="PART_Placeholder"
                                                   Grid.Column="1"
                                                   Text="{TemplateBinding Placeholder}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Opacity="0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   IsHitTestVisible="False" />

                                        <!-- 清除按钮（VD-085）：搜索框有内容时出现，一键清空而不是逐字删。
                                             多行输入不显示（有换行需求，误清代价高）。 -->
                                        <local:SOrButton x:Name="PART_Clear"
                                                         Grid.Column="2"
                                                         Variant="Ghost"
                                                         Icon="{DynamicResource IconClose}"
                                                         IconSize="9"
                                                         Padding="6"
                                                         Margin="4,0,0,0"
                                                         VerticalAlignment="Center"
                                                         ToolTip="{DynamicResource Common_Clear}"
                                                         Command="{TemplateBinding ClearCommand}"
                                                         Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 键盘焦点环（VD-066）：独立 1px 内描边，100ms 淡入、离开即走 -->
                        <Border x:Name="PART_FocusRing"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 占位符：内部输入框「为空」**且**「未聚焦」时才显示。
                             必须用 MultiDataTrigger 把两个条件合起来——拆成两个独立 DataTrigger 时，
                             聚焦后「文本为空」那条仍然命中，EnterActions 的淡入动画会把占位符
                             锁在 0.85，表现为「点进空框、占位符文字还盖在光标位置上」。
                             （MultiTrigger.Condition 不支持 ElementName，MultiDataTrigger.Condition 的
                             Binding 支持，所以这里用 MultiDataTrigger。） -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Text, ElementName=PART_ContentHost}" Value="" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PART_ContentHost}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Placeholder" Property="Opacity" Value="0.85" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource PlaceholderInStoryboard}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource PlaceholderOutStoryboard}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- 多行输入（简介 / 开发规划 / 约束 / 目标 / 验收 等）：
                             VD-070 统一「最小高度 + 自动增长」——不再各页写死 56/70/80，
                             内容多时框体会长到 180 后内部才滚动，短内容也不会白占 80px。 -->
                        <DataTrigger Binding="{Binding AcceptsReturn, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter TargetName="PART_ContentHost" Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter TargetName="PART_ContentHost" Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Setter TargetName="PART_Placeholder" Property="VerticalAlignment" Value="Top" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <Setter Property="MinHeight" Value="{DynamicResource MultilineMinHeight}" />
                            <Setter Property="MaxHeight" Value="{DynamicResource MultilineMaxHeight}" />
                        </DataTrigger>

                        <!-- 清除按钮可见性由代码控制（SOrTextBox.UpdateClearButton）：
                             「内部输入框有内容」这件事在模板触发器里无法用 ElementName 表达
                             （MultiTrigger 的 Condition 不支持 ElementName） -->

                        <!-- 悬浮（VD-011）：覆盖层淡入淡出，不改描边 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 焦点环（VD-066）：条件在内部输入框上 -->
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PART_ContentHost}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingInStoryboard}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingOutStoryboard}" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- 校验失败（VD-091）：边框转语义危险色，并保持到用户重新编辑 -->
                        <DataTrigger Binding="{Binding IsInvalid, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="PART_FocusRing" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SOrComboBox ============================ -->
    <Style TargetType="local:SOrComboBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- VD-073：与输入框同一套「填充低一阶 + 边界 ≥3:1」 -->
        <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrComboBox">
                    <Grid>
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 悬浮覆盖层（VD-011）：鼠标划过仅叠 HoverOverlayBrush 弱底色，不改描边；
                                     ColumnSpan=2 铺满输入区，作为首子级位于内容之下 -->
                                <Border x:Name="PART_Hover"
                                        Grid.ColumnSpan="2"
                                        Background="{DynamicResource HoverOverlayBrush}"
                                        Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False" />
                                <!-- 选中项内容（SelectionBoxItem 自动遵循 ItemTemplate / DisplayMemberPath） -->
                                <ContentPresenter x:Name="PART_ContentSite"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False" />
                                <!-- 无选中项时的占位提示 -->
                                <TextBlock x:Name="PART_Placeholder"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Opacity="0.85"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <!-- 下拉箭头（VD-068）：改为 RotateTransform 旋转，
                                     旧版展开时把 Path.Data 换成反向路径，视觉上「跳」了一下 -->
                                <Path x:Name="PART_Arrow"
                                      Grid.Column="1"
                                      Data="M 0,1.5 L 5,6.5 L 10,1.5"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="10"
                                      Height="7"
                                      Margin="0,0,12,0"
                                      RenderTransformOrigin="0.5,0.5"
                                      IsHitTestVisible="False">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <!-- 整字段可点的开关（IsChecked 与 IsDropDownOpen 双向同步） -->
                                <ToggleButton x:Name="PART_DropDownToggle"
                                              Grid.ColumnSpan="2"
                                              Focusable="False"
                                              Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <!-- 下拉浮层（原生约定：Popup 承载 ItemsPresenter）
                             VD-068：去掉系统 PopupAnimation（固定约 150ms 只淡入不位移），
                             改为自绘「8px 上移 + 150ms 淡入」，与界面其它微交互同源 -->
                        <!-- PlacementTarget 必须显式指向 ComboBox 本体：缺省时 Popup 会 fallback 到
                             模板内的 PART_DropDownToggle（比 ComboBox 矮 8px），浮层于是上偏 8px
                             压住触发器——第一行选项（如「全部类型」）被遮住点不到，
                             表现为「选项与全部类型重叠」且「选过其他项后选不回全部」。
                             12 = 8（PopupRoot 固有上边距补偿）+ 4（与触发器的视觉间距）。
                             另外页面容器入场动画的 RenderTransform 残留也曾造成
                             布局坐标与视觉坐标不一致，已把动画初始态归一为 0
                             （见 Animations.xaml 的 SectionSwitchInStyle）。 -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               VerticalOffset="12"
                               AllowsTransparency="True"
                               Focusable="False"
                               StaysOpen="False"
                               PopupAnimation="None"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                                    Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=PART_Root}"
                                    MaxHeight="{DynamicResource DropDownMaxHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0"
                                                      Color="{DynamicResource ColorShadow}" Opacity="0.22" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter x:Name="ItemsPresenter" Margin="0,0,4,0" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <!-- 键盘焦点环（VD-066）：独立 1px 内描边，淡入淡出 -->
                        <Border x:Name="PART_FocusRing"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 键盘聚焦 / 展开（VD-059）：唯一焦点信号 = 独立焦点环；展开态与聚焦态同信号 -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Arrow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="180" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource CubicEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Arrow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource CubicEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- 校验失败态（VD-091）：边框与焦点环同用语义危险色 -->
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="PART_FocusRing" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉项容器（自定义胶囊高亮，替代系统蓝） -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SOrDatePicker ============================ -->

    <!-- 日历日按钮（CalendarDayButton 由 CalendarItem 代码创建，样式经 Calendar.CalendarDayButtonStyle 注入） -->
    <Style x:Key="SOrCalendarDayButtonStyle" TargetType="CalendarDayButton">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1.5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource PressOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource PressOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="PART_Root" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日历按钮（表头 / 上月 / 下月 / 年视图的月份与年份按钮共用） -->
    <Style x:Key="SOrCalendarButtonStyle" TargetType="CalendarButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource PressOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        日历导航按钮（CalendarItem 的 PART_PreviousButton / PART_HeaderButton / PART_NextButton）。
        注意：这三个部件在 WPF 源码里是普通 Button，不是 CalendarButton——
        套用 TargetType="CalendarButton" 的样式会在加载模板时抛类型不匹配异常（历史崩溃根因）。
    -->
    <Style x:Key="SOrCalendarNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource PressOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        日历整体：保留配色与日期格样式，但**不再自定义 Calendar / CalendarItem 模板**。
        原因：自定义 CalendarItem 模板在 Popup 的自动尺寸约束下测量自洽失败
        （打开日历即抛 OutOfMemoryException，就是「选日期崩溃」的根因）。
        改用 WPF 原生 CalendarItem 内核，只把日期格换成项目样式，功能优先、视觉跟随主题。
    -->
    <Style x:Key="SOrCalendarStyle" TargetType="Calendar">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <!-- 日期框此前用弱 BorderBrush（深色下 #363B42 vs #1B1E23 仅约 1.5:1，等于没有边框），
             改用 BorderStrongBrush 与其它输入类控件同档（≥3:1） -->
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource SOrCalendarDayButtonStyle}" />
        <!-- 月/年视图的按钮（点头部切换后的月份格、十年格）此前用系统默认样式——
             白底 + 系统蓝高亮，在深色主题下十分刺眼（用户报「点击月份/年后界面未适配」）。
             CalendarItem 仍用原生内核（自定义模板会 OOM，见下方注释），只把按钮换成项目样式。 -->
        <Setter Property="CalendarButtonStyle" Value="{StaticResource SOrCalendarButtonStyle}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- DatePicker 内部文本框（仅设属性，保留默认模板的 PART_ContentHost 与水印状态） -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="11,0,4,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="local:SOrDatePicker">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="CalendarStyle" Value="{StaticResource SOrCalendarStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrDatePicker">
                    <Grid>
                        <Border x:Name="PART_Root"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 悬浮覆盖层（VD-011）：鼠标划过仅叠 HoverOverlayBrush 弱底色，不改描边；
                                     ColumnSpan=2 铺满输入区，作为首子级位于内容之下 -->
                                <Border x:Name="PART_Hover"
                                        Grid.ColumnSpan="2"
                                        Background="{DynamicResource HoverOverlayBrush}"
                                        Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False" />
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" />
                                <!-- 日历图标按钮（真实 Button：代码为其挂 Click 切换下拉） -->
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="30"
                                        Margin="0,0,3,0"
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PART_BtnRoot" Background="Transparent" CornerRadius="{DynamicResource CornerRadiusSmall}">
                                                <Path Data="M 1,2.5 L 1,10.5 L 12.5,10.5 L 12.5,4.5 L 4.5,4.5
                                                          M 1,2.5 L 4.5,4.5 M 12.5,4.5 L 9.5,2.5 L 6.75,4.5
                                                          M 4.5,4.5 L 4.5,2.5 M 9.5,4.5 L 9.5,2.5"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Stretch="Uniform"
                                                      Width="14" Height="14" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PART_BtnRoot" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- 原生约定：Popup 内不写内容，DatePicker 会把内置 Calendar 赋给 Popup.Child -->
                        <!-- VD-068：日历统一向下弹（旧版永远向上，在页面中部展开时会盖住上方输入框）；
                             浮层的 8px + 150ms 入场动画在 SOrDatePicker.OnApplyTemplate 里对 Calendar 施加 -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               VerticalOffset="4"
                               AllowsTransparency="True"
                               Focusable="False"
                               StaysOpen="False"
                               PopupAnimation="None"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- 键盘焦点环（VD-066）：独立 1px 内描边 -->
                        <Border x:Name="PART_FocusRing"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MicroOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 键盘聚焦 / 展开（VD-059）：唯一焦点信号 = 独立焦点环 -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- 校验失败态（VD-091）：边框与焦点环同用语义危险色 -->
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="PART_FocusRing" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SOrSlider ============================ -->
    <!--
        统一粗细的单条轨道：底轨与已填充段同为 6px 圆头，视觉上是一整条（两段圆），
        中间圆形拖块可拖动，填充长度跟随拖块（Track 的 DecreaseRepeatButton 自动改变宽度）。
        左右两端都用 Pill 圆角，填充段右端为直角，避免拖块处出现第二次圆头。
    -->
    <Style TargetType="local:SOrSlider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrSlider">
                    <!--
                        命名层：PART_Root（轨道容器）、PART_Track（原生约定，值/方向由 Track 自动绑定模板父级，
                        因此 XAML 中不得为 Track 显式设置 Value/Minimum/Maximum/Orientation）。
                    -->
                    <Grid x:Name="PART_Root" Background="Transparent" VerticalAlignment="Center">
                        <!-- 底轨：整条 6px、两端圆头。颜色刻意比填充色浅一档（不是更浅），
                             否则深色填充在视觉上更「重」，会让人误以为两边比中间细。 -->
                        <Border Background="{DynamicResource SliderTrackBrush}"
                                Height="8"
                                CornerRadius="{DynamicResource CornerRadiusBar}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <!-- Command 置空：轨道点击由 SOrSlider 在预览阶段接管并动画滑到点击处，
                                     不再走 LargeChange 步进（避免与动画抢逻辑） -->
                                <RepeatButton Command="{x:Null}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- 已填充段：与底轨同高同圆角，左端圆头、右端直角，与拖块无缝衔接 -->
                                            <Border Background="{DynamicResource PrimaryBrush}"
                                                    Height="8"
                                                    CornerRadius="3,0,0,3"
                                                    VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <!-- 拖块：纯圆环，不加实心内点，避免「中间一个大点、两边细」的观感。
                                     不再设 Focusable="False"（VD-016）：滑块可经 Tab 获焦，
                                     方向键 / PageUp / PageDown / Home / End 均可调节（Slider 基座内置键盘处理）。 -->
                                <Thumb Cursor="Hand" Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource SurfaceBrush}"
                                                     Stroke="{DynamicResource PrimaryBrush}"
                                                     StrokeThickness="1.5" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Null}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <!-- 键盘焦点环（VD-059）：滑块获焦时标识焦点，配合方向键调节；1px FocusRingBrush 内描边 -->
                        <Border x:Name="PART_FocusRing"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusBar}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SOrToggleSwitch（VD-108） ============================ -->
    <Style TargetType="local:SOrToggleSwitch">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="44" />
        <!-- 轨道高度 24 → 20（用户反馈「开关的宽度（上下）降低一点」）：thumb 同步 18 → 14，
             开启位移 20 → 24（44 - 3 - 14 - 3） -->
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SOrToggleSwitch">
                    <Grid Width="44" Height="20">
                        <!-- 关闭态轨道：与输入框边界同档，保证「这是个可操作控件」而不是一条淡线 -->
                        <Border x:Name="PART_TrackOff"
                                Background="{DynamicResource BorderStrongBrush}"
                                CornerRadius="{TemplateBinding TrackCornerRadius}" />
                        <!-- 开启态轨道：主色，透明度 0→1 过渡，避免开关瞬间「跳色」 -->
                        <Border x:Name="PART_TrackOn"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="{TemplateBinding TrackCornerRadius}"
                                Opacity="0" />
                        <!-- 圆点：反色，随 IsChecked 在轨道内平移 20px -->
                        <Border x:Name="PART_Thumb" Width="14" Height="14" Margin="3"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource TextOnAccentBrush}"
                                CornerRadius="7">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                                  Color="{DynamicResource ColorShadow}" Opacity="0.28" />
                            </Border.Effect>
                        </Border>
                        <!-- 焦点框：与其它控件同一支画刷，设置里可一键关闭 -->
                        <Border x:Name="PART_FocusRing" Margin="-3"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="1" CornerRadius="11"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 动画由 SOrToggleSwitch 代码侧播放（模板 Setter 若替换 RenderTransform
                                 对象会让 Storyboard 目标失效，表现为「一点就跳」）。
                                 这里的 Setter 只作保底：动画未运行时开启态也显示正确。 -->
                            <Setter TargetName="PART_TrackOn" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingInStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusRingOutStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_TrackOff" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
