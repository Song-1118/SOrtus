<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        尺寸与模糊档位（规范 7.3 / 7.6）：模糊半径统一使用命名档位，禁止页面内硬编码数值。
        GlobalBlurRadius 为全局模糊强度，由 ThemeService 在运行时修改（改一处全应用生效）。
    -->

    <!-- 模糊半径档位 -->
    <sys:Double x:Key="BlurRadiusNone">0</sys:Double>
    <sys:Double x:Key="BlurRadiusSubtle">6</sys:Double>
    <sys:Double x:Key="BlurRadiusNormal">12</sys:Double>
    <sys:Double x:Key="BlurRadiusStrong">20</sys:Double>
    <sys:Double x:Key="BlurRadiusOverlay">30</sys:Double>

    <!-- 全局模糊强度（运行时由 ThemeService 写入：未自定义时取 BlurRadiusNormal 档位，自定义时取用户设置；
         此处的字面量仅作 XAML 设计期与初始化前的兜底值） -->
    <sys:Double x:Key="GlobalBlurRadius">12</sys:Double>

    <!-- 圆角半径 -->
    <CornerRadius x:Key="CornerRadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">18</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">999</CornerRadius>

    <!-- 线性控件圆角：刻意小于高度的一半，视觉上才是「圆角矩形」而不是「胶囊 / 椭圆」 -->
    <CornerRadius x:Key="CornerRadiusBar">3</CornerRadius>
    <CornerRadius x:Key="CornerRadiusThumb">2</CornerRadius>

    <!-- 间距（Thickness：用于 Padding / Margin；WPF 不接受 Double） -->
    <Thickness x:Key="SpacingXs">4</Thickness>
    <Thickness x:Key="SpacingSm">8</Thickness>
    <Thickness x:Key="SpacingMd">12</Thickness>
    <Thickness x:Key="SpacingLg">16</Thickness>
    <Thickness x:Key="SpacingXl">24</Thickness>

    <!-- 输入类控件文本内边距（左右统一 12；上下由控件高度居中控制） -->
    <Thickness x:Key="InputInsetHorizontal">12,0,12,0</Thickness>

    <!-- 多行输入（简介 / 开发规划等）：左右 12 + 上下 8，文本左上对齐 -->
    <Thickness x:Key="InputInsetMultiline">12,8,12,8</Thickness>

    <!-- 图标与文字的固定间距（按钮 / 输入框前置图标统一 8px） -->
    <Thickness x:Key="IconGap">0,0,8,0</Thickness>

    <!-- 阴影模糊半径（规范 7.6：圆角 + 阴影全局统一） -->
    <sys:Double x:Key="ShadowBlur">24</sys:Double>
    <sys:Double x:Key="ShadowOpacity">0.18</sys:Double>

    <!-- 控件基准高度（输入框 / 下拉框 / 日期选择器统一） -->
    <sys:Double x:Key="ControlHeight">36</sys:Double>

    <!-- 下拉浮层最大高度（超出后内部滚动） -->
    <sys:Double x:Key="DropDownMaxHeight">320</sys:Double>

    <!--
        字号五档（VD-001）：全站统一引用，禁止页面 / 控件模板内联字面量。
        档位语义（与 UI 设计方案 2.4 字号阶梯对应，7 档旧字面量收敛为 5 档）：
          FontSizeTitle    页面标题（旧 22）
          FontSizeSection  分区标题 / 卡片标题 / 弹窗标题（旧 17 / 15 / 16 / 18）
          FontSizeBody     正文 / 输入内容（旧 14）
          FontSizeLabel    字段标签（旧 13，与 14px 输入内容形成 1px 层级差）
          FontSizeCaption  辅助说明 / 脚注（旧 12 / 11）
        主题无关，但与全局令牌引用方式一致，一律用 DynamicResource。
    -->
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeSection">16</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeLabel">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>

    <!-- 品牌字号（侧边栏 SOrtus 字样，UI 设计方案 2.4「28=品牌」档，不参与五档收敛） -->
    <sys:Double x:Key="FontSizeBrand">28</sys:Double>

    <!-- 内容区版心最大宽度（VD-059：全站统一 1120 软上限——窗口小于该宽度时表单完全撑满、
         无居中窄条观感；仅当窗口超过该宽度时才停在上限，保证超宽窗口下行长仍可扫读。
         页面引用时不得再加 HorizontalAlignment="Center"，避免退回居中排版） -->
    <sys:Double x:Key="ContentMaxWidth">1120</sys:Double>

</ResourceDictionary>
