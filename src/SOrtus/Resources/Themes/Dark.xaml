<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        深色主题（中性配色）。资源键与 Light.xaml 完全一一对应（规范 7.8），仅取值不同。
        设计约束：纯中性深色底、无渐变、无蓝紫；主色为近白，靠灰阶与细边框表达层次。
    -->

    <Color x:Key="ColorBackgroundA">#131519</Color>
    <Color x:Key="ColorBackgroundB">#0B0D10</Color>
    <Color x:Key="ColorAccentA">#F3F4F6</Color>
    <Color x:Key="ColorAccentB">#9CA3AF</Color>
    <Color x:Key="ColorAccentC">#6B7280</Color>

    <Color x:Key="ColorTextPrimary">#F3F4F6</Color>
    <Color x:Key="ColorTextSecondary">#A9B0BA</Color>
    <Color x:Key="ColorTextOnAccent">#111827</Color>
    <Color x:Key="ColorBorder">#363B42</Color>
    <Color x:Key="ColorSurface">#23262B</Color>
    <!-- 卡片内再嵌一张分组卡时的底色（VD-077）：比外层低一阶，卡片套卡片才有明暗差 -->
    <Color x:Key="ColorSurfaceAlt">#1E2126</Color>
    <!-- 输入类控件的填充（VD-073）：比卡片略低一阶，深色下不再是「一块稍亮的矩形」 -->
    <Color x:Key="ColorInputSurface">#1B1E23</Color>
    <!-- 控件边界专用（VD-073）：对卡片底色实测 3.30:1，满足 WCAG 1.4.11 的 3:1 -->
    <!-- 输入类控件边界：用户反馈「边框与背景同色、看不见」。
         原值 #6E7681 对 #1B1E23 填充是 3.73:1（达线但偏弱），#7E8896 仍偏弱；
         提到 #9AA4B2 后约 6.1:1，1px 的细边框也能明确可辨（保持 1px，不靠加粗） -->
    <Color x:Key="ColorBorderStrong">#9AA4B2</Color>
    <!-- 中性标签描边（VD-074）：描边式胶囊，形状可辨 -->
    <Color x:Key="ColorTagNeutralBorder">#5A6270</Color>
    <Color x:Key="ColorPrimary">#F3F4F6</Color>
    <!-- 键盘焦点环专用色（VD-059）：中间灰度，与 Surface(#23262B) 和 Primary 填充(#F3F4F6) 均保持可见对比；
         不用 Primary 本身——主按钮底色即近白 Primary，同色环在按钮上不可见 -->
    <!-- 品牌标记：窗框用主墨、光点用次级灰（深色主题为反白两档，保持同层级关系） -->
    <Color x:Key="ColorBrandMarkFrame">#F3F4F6</Color>
    <Color x:Key="ColorBrandMarkDot">#A9B0BA</Color>
    <Color x:Key="ColorFocusRing">#8E98A8</Color>
    <Color x:Key="ColorShadow">#000000</Color>

    <!-- 语义色（VD-075）：危险 / 成功各只保留一套，按钮与标签同族（深色用亮字） -->
    <Color x:Key="ColorDanger">#FDA29B</Color>
    <Color x:Key="ColorSuccess">#75E0A7</Color>

    <!-- 模糊覆盖层颜色：深色为深灰覆盖（配合 OverlayOpacity 控制磨砂通透度） -->
    <Color x:Key="BlurOverlayColor">#FF22252A</Color>

    <!-- 标签色板（SOrTag Tone）：中性深底亮字 -->
    <Color x:Key="ColorTagAccentABg">#2B3036</Color>
    <Color x:Key="ColorTagAccentAFg">#E5E7EB</Color>
    <Color x:Key="ColorTagAccentBBg">#2B3036</Color>
    <Color x:Key="ColorTagAccentBFg">#D1D5DB</Color>
    <Color x:Key="ColorTagAccentCBg">#2B3036</Color>
    <Color x:Key="ColorTagAccentCFg">#9CA3AF</Color>
    <Color x:Key="ColorTagSuccessBg">#123024</Color>
    <Color x:Key="ColorTagSuccessFg">#75E0A7</Color>
    <Color x:Key="ColorTagWarningBg">#32260B</Color>
    <Color x:Key="ColorTagWarningFg">#FEC84B</Color>
    <Color x:Key="ColorTagDangerBg">#33191B</Color>
    <Color x:Key="ColorTagDangerFg">#FDA29B</Color>
    <Color x:Key="ColorTagNeutralBg">#2B3036</Color>
    <Color x:Key="ColorTagNeutralFg">#9CA3AF</Color>

    <!-- 交互层：悬浮 / 按压覆盖（白色，深色主题） -->
    <Color x:Key="ColorHoverOverlay">#14FFFFFF</Color>
    <Color x:Key="ColorPressOverlay">#24FFFFFF</Color>

    <!-- 导航 / 列表选中高亮 -->
    <Color x:Key="ColorNavActive">#2B3036</Color>

    <!-- 滚动条滑块（VD-072）：对卡片底色 3.30:1 / 悬停 5.95:1，满足 WCAG 1.4.11 的 3:1 -->
    <Color x:Key="ColorScrollThumb">#6E7681</Color>
    <Color x:Key="ColorScrollThumbHover">#9AA3AF</Color>

    <!-- 背景装饰（仅中性灰阶）：深色主题用比底色略亮的中性灰，避免出现刺眼白斑 -->
    <Color x:Key="ColorBackdropGlow">#FF1B1F24</Color>
    <Color x:Key="ColorBackdropTint">#FF21262C</Color>

    <!-- 滑块底轨（比分隔线亮一档，避免左右两段因对比差显得粗细不一） -->
    <Color x:Key="ColorSliderTrack">#4A515A</Color>

</ResourceDictionary>
