<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题（中性配色）。资源键与 Dark.xaml 完全一一对应（规范 7.8），仅取值不同。
        设计约束：背景纯白、无渐变、无蓝紫；主色为近黑，靠中性灰阶与细边框表达层次。
        32 个键不得增减（缺键会导致主题整本替换后解析失败）。
    -->

    <Color x:Key="ColorBackgroundA">#EDF0F4</Color>
    <Color x:Key="ColorBackgroundB">#E1E5EB</Color>
    <Color x:Key="ColorAccentA">#111827</Color>
    <Color x:Key="ColorAccentB">#6B7280</Color>
    <Color x:Key="ColorAccentC">#9CA3AF</Color>

    <Color x:Key="ColorTextPrimary">#111827</Color>
    <Color x:Key="ColorTextSecondary">#6B7280</Color>
    <Color x:Key="ColorTextOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#E5E7EB</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorPrimary">#111827</Color>
    <Color x:Key="ColorShadow">#9CA3AF</Color>

    <!-- 模糊覆盖层颜色：浅色为纯白覆盖（配合 OverlayOpacity 控制磨砂通透度） -->
    <Color x:Key="BlurOverlayColor">#FFFFFFFF</Color>

    <!-- 标签色板（SOrTag Tone）：中性浅底深字，对比度 >= 4.5:1 -->
    <Color x:Key="ColorTagAccentABg">#F3F4F6</Color>
    <Color x:Key="ColorTagAccentAFg">#111827</Color>
    <Color x:Key="ColorTagAccentBBg">#F3F4F6</Color>
    <Color x:Key="ColorTagAccentBFg">#374151</Color>
    <Color x:Key="ColorTagAccentCBg">#F3F4F6</Color>
    <Color x:Key="ColorTagAccentCFg">#4B5563</Color>
    <Color x:Key="ColorTagSuccessBg">#ECFDF3</Color>
    <Color x:Key="ColorTagSuccessFg">#067647</Color>
    <Color x:Key="ColorTagWarningBg">#FFFAEB</Color>
    <Color x:Key="ColorTagWarningFg">#B54708</Color>
    <Color x:Key="ColorTagDangerBg">#FEF3F2</Color>
    <Color x:Key="ColorTagDangerFg">#B42318</Color>
    <Color x:Key="ColorTagNeutralBg">#F3F4F6</Color>
    <Color x:Key="ColorTagNeutralFg">#6B7280</Color>

    <!-- 交互层：悬浮 / 按压覆盖（中性墨色，浅色主题） -->
    <Color x:Key="ColorHoverOverlay">#0F111827</Color>
    <Color x:Key="ColorPressOverlay">#1A111827</Color>

    <!-- 导航 / 列表选中高亮 -->
    <Color x:Key="ColorNavActive">#F3F4F6</Color>

    <!-- 滚动条滑块 -->
    <Color x:Key="ColorScrollThumb">#D1D5DB</Color>
    <Color x:Key="ColorScrollThumbHover">#9CA3AF</Color>

    <!-- 背景装饰（仅中性灰阶）：glow=柔光，tint=网格/暗面 -->
    <Color x:Key="ColorBackdropGlow">#FFFFFFFF</Color>
    <Color x:Key="ColorBackdropTint">#FFC2C9D4</Color>

    <!-- 滑块底轨（比分隔线深一档，避免左右两段因对比差显得粗细不一） -->
    <Color x:Key="ColorSliderTrack">#C6CCD6</Color>

</ResourceDictionary>
