<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题。资源键与 Dark.xaml 完全一一对应（规范 7.8），
        仅取值不同，确保整本替换后无缺键、模糊层等正确响应。
    -->

    <Color x:Key="ColorBackgroundA">#EAF0FF</Color>
    <Color x:Key="ColorBackgroundB">#F7E9FF</Color>
    <Color x:Key="ColorAccentA">#6366F1</Color>
    <Color x:Key="ColorAccentB">#0EA5E9</Color>
    <Color x:Key="ColorAccentC">#EC4899</Color>

    <Color x:Key="ColorTextPrimary">#1F2430</Color>
    <Color x:Key="ColorTextSecondary">#5B6472</Color>
    <Color x:Key="ColorTextOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#E3E8F0</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorPrimary">#4F46E5</Color>
    <Color x:Key="ColorShadow">#1F2937</Color>

    <!-- 模糊覆盖层颜色：浅色为近白覆盖（配合 OverlayOpacity 控制磨砂玻璃的通透度，保证正文对比度） -->
    <Color x:Key="BlurOverlayColor">#FFFBFCFF</Color>

    <!-- 标签色板（SOrTag Tone）：浅底深字，对比度 >= 4.5:1 -->
    <Color x:Key="ColorTagAccentABg">#EEEDFE</Color>
    <Color x:Key="ColorTagAccentAFg">#3C3489</Color>
    <Color x:Key="ColorTagAccentBBg">#E6F1FB</Color>
    <Color x:Key="ColorTagAccentBFg">#0C447C</Color>
    <Color x:Key="ColorTagAccentCBg">#FBEAF0</Color>
    <Color x:Key="ColorTagAccentCFg">#72243E</Color>
    <Color x:Key="ColorTagSuccessBg">#EAF3DE</Color>
    <Color x:Key="ColorTagSuccessFg">#27500A</Color>
    <Color x:Key="ColorTagWarningBg">#FAEEDA</Color>
    <Color x:Key="ColorTagWarningFg">#854F0B</Color>
    <Color x:Key="ColorTagDangerBg">#FCEBEB</Color>
    <Color x:Key="ColorTagDangerFg">#791F1F</Color>
    <Color x:Key="ColorTagNeutralBg">#F1EFE8</Color>
    <Color x:Key="ColorTagNeutralFg">#444441</Color>

    <!-- 交互层：悬浮 / 按压覆盖（深色墨，浅色主题） -->
    <Color x:Key="ColorHoverOverlay">#141F2430</Color>
    <Color x:Key="ColorPressOverlay">#261F2430</Color>

    <!-- 导航 / 列表选中高亮 -->
    <Color x:Key="ColorNavActive">#E8E7FC</Color>

    <!-- 滚动条滑块 -->
    <Color x:Key="ColorScrollThumb">#C4CBDA</Color>
    <Color x:Key="ColorScrollThumbHover">#AEB8CC</Color>

</ResourceDictionary>
