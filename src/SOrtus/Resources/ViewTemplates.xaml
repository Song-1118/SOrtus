<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:SOrtus.Controls"
                      xmlns:vm="clr-namespace:SOrtus.ViewModels"
                      xmlns:core="clr-namespace:SOrtus.Core.Models;assembly=SOrtus.Core"
                      xmlns:conv="clr-namespace:SOrtus.Converters">

    <!-- 视图模型 -> 视图 映射（规范：简单内容区切换，DataTemplate 驱动，无重型框架）。 -->

    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
    <conv:TypeEqualsConverter x:Key="TypeEqualsConverter" />
    <conv:ProjectTypeDisplayConverter x:Key="ProjectTypeDisplayConverter" />
    <conv:ProjectStatusDisplayConverter x:Key="ProjectStatusDisplayConverter" />
    <conv:ProjectTypeToToneConverter x:Key="ProjectTypeToToneConverter" />
    <conv:ProjectStatusToToneConverter x:Key="ProjectStatusToToneConverter" />

    <!-- 下拉框通用：可空枚举 → 本地化文本 -->
    <DataTemplate x:Key="TypeItemTemplate">
        <TextBlock Text="{Binding Converter={StaticResource ProjectTypeDisplayConverter}}" />
    </DataTemplate>
    <DataTemplate x:Key="StatusItemTemplate">
        <TextBlock Text="{Binding Converter={StaticResource ProjectStatusDisplayConverter}}" />
    </DataTemplate>

    <!-- ============================ 立项列表 ============================ -->
    <DataTemplate DataType="{x:Type vm:ProjectListViewModel}">
        <local:SOrCard VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 头部：标题 + 统计 + 新建 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Nav_Projects}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <local:SOrButton Grid.Column="1" Variant="Primary"
                                        Icon="{DynamicResource IconPlus}"
                                        Content="{DynamicResource List_NewButton}"
                                        Command="{Binding NewCommand}"
                                        VerticalAlignment="Center" />
                    </Grid>

                    <!-- 工具栏：搜索 / 类型筛选 / 状态筛选 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:SOrTextBox Grid.Column="0" LeadingIcon="{DynamicResource IconSearch}"
                                          Placeholder="{DynamicResource List_SearchPlaceholder}"
                                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <local:SOrComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}"
                                          SelectedItem="{Binding FilterType}"
                                          ItemTemplate="{StaticResource TypeItemTemplate}"
                                          Placeholder="{DynamicResource List_TypeAll}"
                                          Margin="10,0,0,0" MinWidth="130" />
                        <local:SOrComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding FilterStatus}"
                                          ItemTemplate="{StaticResource StatusItemTemplate}"
                                          Placeholder="{DynamicResource List_StatusAll}"
                                          Margin="10,0,0,0" MinWidth="130" />
                    </Grid>

                    <!-- 列表 / 空状态 -->
                    <ItemsControl ItemsSource="{Binding Projects}"
                                  Visibility="{Binding Projects.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:SOrProjectListItem Project="{Binding}"
                                                          Margin="0,0,0,10"
                                                          OpenCommand="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态：完全没有任何立项 -->
                    <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center" Margin="0,30,0,0">
                        <TextBlock Text="{DynamicResource List_Empty}" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <local:SOrButton Content="{DynamicResource List_NewButton}"
                                        Command="{Binding NewCommand}"
                                        Variant="Primary"
                                        Margin="0,14,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 空状态：有数据但被筛选过滤为空 -->
                    <TextBlock Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}"
                               Text="{DynamicResource List_NoResults}" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,30,0,0" />
                </StackPanel>
            </ScrollViewer>
        </local:SOrCard>
    </DataTemplate>

    <!-- ============================ 立项向导（两步） ============================ -->
    <DataTemplate DataType="{x:Type vm:ProjectWizardViewModel}">
        <local:SOrCard VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="760" Margin="4">
                    <TextBlock Text="{DynamicResource Nav_NewProject}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" />

                    <!-- 第 1 步：选择类型 -->
                    <StackPanel Visibility="{Binding IsStepType, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Wizard_StepType}" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="{DynamicResource Wizard_Step1Hint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,14" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <local:SOrButton Grid.Column="0" Variant="Secondary"
                                            Command="{Binding SelectTypeCommand}"
                                            CommandParameter="{x:Static core:ProjectType.Programming}"
                                            IsActive="{Binding SelectedType, Converter={StaticResource TypeEqualsConverter}, ConverterParameter=Programming}"
                                            HorizontalContentAlignment="Left" Margin="0,0,10,0" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource List_TypeProgramming}" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="{DynamicResource Wizard_TypeProgrammingDesc}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </local:SOrButton>

                            <local:SOrButton Grid.Column="1" Variant="Secondary"
                                            Command="{Binding SelectTypeCommand}"
                                            CommandParameter="{x:Static core:ProjectType.Clip}"
                                            IsActive="{Binding SelectedType, Converter={StaticResource TypeEqualsConverter}, ConverterParameter=Clip}"
                                            HorizontalContentAlignment="Left" Margin="0,0,10,0" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource List_TypeClip}" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="{DynamicResource Wizard_TypeClipDesc}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </local:SOrButton>

                            <local:SOrButton Grid.Column="2" Variant="Secondary"
                                            Command="{Binding SelectTypeCommand}"
                                            CommandParameter="{x:Static core:ProjectType.Todo}"
                                            IsActive="{Binding SelectedType, Converter={StaticResource TypeEqualsConverter}, ConverterParameter=Todo}"
                                            HorizontalContentAlignment="Left" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource List_TypeTodo}" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="{DynamicResource Wizard_TypeTodoDesc}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </local:SOrButton>
                        </Grid>

                        <local:SOrButton Content="{DynamicResource Wizard_Next}" Variant="Primary"
                                        Command="{Binding NextStepCommand}"
                                        Margin="0,20,0,0" HorizontalAlignment="Right" Padding="22,10" />
                    </StackPanel>

                    <!-- 第 2 步：填写信息 -->
                    <StackPanel Visibility="{Binding IsStepInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock>
                            <Run Text="{DynamicResource Wizard_SelectedType}" FontWeight="Bold" FontSize="15" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedTypeName}" Foreground="{DynamicResource PrimaryBrush}"
                                   FontWeight="SemiBold" Margin="0,2,0,14" />

                        <TextBlock Text="{DynamicResource Wizard_Name}" FontWeight="SemiBold" />
                        <local:SOrTextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Placeholder="{DynamicResource Wizard_NamePlaceholder}"
                                         Margin="0,6,0,14" />

                        <TextBlock Text="{DynamicResource Wizard_TechStack}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Wizard_TechStackPresets}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,6" />
                        <ItemsControl ItemsSource="{Binding TechStackPresets}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:SOrButton Variant="Secondary" Content="{Binding Name}"
                                                    IsActive="{Binding IsSelected}"
                                                    FontSize="12" FontWeight="Normal" Padding="12,6"
                                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                                    Margin="0,0,8,8"
                                                    Command="{Binding DataContext.TogglePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{DynamicResource Wizard_TechStackCustom}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <local:SOrTextBox Text="{Binding TechStackInput, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="{DynamicResource Wizard_TechStackPlaceholder}"
                                             MinWidth="280" />
                            <local:SOrButton Command="{Binding AddTechStackCommand}" Content="+" FontSize="18"
                                            Variant="Secondary" Margin="8,0,0,0" Padding="14,4" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TechStacks}" Margin="0,4,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:SOrTag Margin="0,0,8,8" Tone="AccentA">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" />
                                            <local:SOrButton Content="✕" Variant="Ghost" FontSize="11" FontWeight="Normal"
                                                            Padding="6,0" Margin="4,0,0,0" ToolTip="{DynamicResource Detail_Delete}"
                                                            Command="{Binding DataContext.RemoveTechStackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </local:SOrTag>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{DynamicResource Wizard_Summary}" FontWeight="SemiBold" />
                        <local:SOrTextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Height="80"
                                         AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,14" />

                        <TextBlock Text="{DynamicResource Wizard_SubType}" FontWeight="SemiBold" />
                        <local:SOrComboBox ItemsSource="{Binding SubTypeOptions}" SelectedItem="{Binding SubType}"
                                          Margin="0,6,0,14" MinWidth="200" />

                        <TextBlock Text="{DynamicResource Wizard_Folder}" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:SOrTextBox Grid.Column="0"
                                             Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="{DynamicResource Wizard_FolderPlaceholder}" />
                            <local:SOrButton Grid.Column="1" Command="{Binding BrowseFolderCommand}"
                                            Content="{DynamicResource Wizard_FolderBrowse}"
                                            Variant="Secondary" Margin="8,0,0,0"
                                            Padding="16,0" VerticalAlignment="Stretch" />
                        </Grid>

                        <TextBlock Text="{DynamicResource Wizard_Schedule}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
                            <local:SOrDatePicker SelectedDate="{Binding ScheduleStart}" Margin="0,0,10,0" />
                            <local:SOrDatePicker SelectedDate="{Binding ScheduleEnd}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <local:SOrButton Content="{DynamicResource Wizard_Back}" Variant="Ghost"
                                            Command="{Binding PreviousStepCommand}" Padding="18,10" />
                            <local:SOrButton Content="{DynamicResource Wizard_Create}" Variant="Primary"
                                            Command="{Binding CreateCommand}" Margin="12,0,0,0" Padding="22,10" />
                            <local:SOrButton Content="{DynamicResource Wizard_Cancel}" Variant="Secondary"
                                            Command="{Binding CancelCommand}" Margin="12,0,0,0" Padding="22,10" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Wizard_CreateHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </local:SOrCard>
    </DataTemplate>

    <!-- ============================ 立项详情 ============================ -->
    <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
        <local:SOrCard VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="760" Margin="4">
                    <!-- 头部：返回 + 标题 + 未保存徽标 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:SOrButton Grid.Column="0" Variant="Ghost" Icon="{DynamicResource IconBack}"
                                        Command="{Binding BackCommand}" Padding="12,9" />
                        <TextBlock Grid.Column="1" Text="{Binding Project.Name}" FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                        <local:SOrTag Grid.Column="2" Tone="Warning" Content="{DynamicResource Detail_UnsavedBadge}"
                                     Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"
                                     VerticalAlignment="Center" />
                    </Grid>

                    <!-- 类型胶囊 + 状态胶囊（只读徽标）与状态编辑下拉 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:SOrTag Margin="0,0,8,0"
                                          Tone="{Binding Project.Type, Converter={StaticResource ProjectTypeToToneConverter}}">
                                <TextBlock Text="{Binding Project.Type, Converter={StaticResource ProjectTypeDisplayConverter}}" FontSize="12" />
                            </local:SOrTag>
                            <local:SOrTag Tone="{Binding Status, Converter={StaticResource ProjectStatusToToneConverter}}">
                                <TextBlock Text="{Binding Status, Converter={StaticResource ProjectStatusDisplayConverter}}" FontSize="12" />
                            </local:SOrTag>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Detail_Status}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <local:SOrComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding Status}"
                                              ItemTemplate="{StaticResource StatusItemTemplate}"
                                              MinWidth="140" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Wizard_Name}" FontWeight="SemiBold" />
                    <local:SOrTextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,14" />

                    <TextBlock Text="{DynamicResource Wizard_Summary}" FontWeight="SemiBold" />
                    <local:SOrTextBox Text="{Binding Project.Summary, UpdateSourceTrigger=PropertyChanged}" Height="70"
                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Wizard_SubType}" FontWeight="SemiBold" />
                            <local:SOrTextBox Text="{Binding Project.SubType, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{DynamicResource Wizard_Folder}" FontWeight="SemiBold" />
                            <local:SOrTextBox Text="{Binding Project.FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Wizard_TechStack}" FontWeight="SemiBold" />
                    <local:SOrTextBox Text="{Binding TechStackText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,14" />

                    <TextBlock Text="{DynamicResource Detail_DevPlan}" FontWeight="SemiBold" />
                    <local:SOrTextBox Text="{Binding Project.DevPlan, UpdateSourceTrigger=PropertyChanged}" Height="70"
                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,14" />

                    <TextBlock Text="{DynamicResource Detail_Constraints}" FontWeight="SemiBold" />
                    <local:SOrTextBox Text="{Binding Project.Constraints, UpdateSourceTrigger=PropertyChanged}" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,14" />

                    <TextBlock Text="{DynamicResource Detail_Goals}" FontWeight="SemiBold" />
                    <local:SOrTextBox Text="{Binding Project.Goals, UpdateSourceTrigger=PropertyChanged}" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,14" />

                    <TextBlock Text="{DynamicResource Detail_Acceptance}" FontWeight="SemiBold" />
                    <local:SOrTextBox Text="{Binding Project.AcceptanceCriteria, UpdateSourceTrigger=PropertyChanged}" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,14" />

                    <TextBlock Text="{DynamicResource Detail_Progress}" FontWeight="SemiBold" />
                    <Grid Margin="0,6,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:SOrSlider Grid.Column="0" Minimum="0" Maximum="100"
                                         Value="{Binding Project.ProgressPercent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding Project.ProgressPercent, StringFormat={}{0:0}%}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <local:SOrButton Content="{DynamicResource Detail_Save}" Variant="Primary"
                                        Command="{Binding SaveCommand}" Padding="22,10" />
                        <local:SOrButton Content="{DynamicResource Detail_Delete}" Variant="Danger"
                                        Command="{Binding DeleteCommand}" Margin="12,0,0,0" Padding="22,10" />
                    </StackPanel>

                    <!-- 时间戳页脚（创建 / 更新，本地时区） -->
                    <TextBlock Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding CreatedText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </local:SOrCard>
    </DataTemplate>

    <!-- ============================ 设置 ============================ -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <local:SOrCard VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="560" Margin="4">
                    <TextBlock Text="{DynamicResource Settings_Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" />

                    <TextBlock Text="{DynamicResource Settings_Appearance}" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                    <TextBlock Text="{DynamicResource Settings_Theme}" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <local:SOrComboBox ItemsSource="{Binding ThemeOptions}"
                                      SelectedValue="{Binding CurrentTheme}" SelectedValuePath="Value"
                                      DisplayMemberPath="Display" Margin="0,0,0,14" />

                    <TextBlock Text="{DynamicResource Settings_Blur}" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:SOrSlider Grid.Column="0" Minimum="0" Maximum="30"
                                         Value="{Binding BlurRadius}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding BlurSummary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <local:SOrComboBox ItemsSource="{Binding BlurOptions}"
                                      SelectedValue="{Binding SelectedBlurValue}" SelectedValuePath="Value"
                                      DisplayMemberPath="Display" Margin="0,4,0,14" />
                    <TextBlock Text="{DynamicResource Settings_BlurLiveHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <local:SOrComboBox ItemsSource="{Binding LanguageOptions}"
                                      SelectedValue="{Binding CurrentLanguage}" SelectedValuePath="Value"
                                      DisplayMemberPath="Display" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding LanguageSoonHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,0,18" TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource Settings_Data}" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource Settings_AboutLocal}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Settings_AboutLicense}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Settings_AboutDb}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </local:SOrCard>
    </DataTemplate>

    <!-- ============================ 确认 / 提示对话框 ============================ -->
    <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource BlurDialogStyle}" MinWidth="320" MaxWidth="420" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Margin="0,10,0,18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <local:SOrButton Content="{Binding CancelText}" Variant="Secondary"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <local:SOrButton Content="{Binding ConfirmText}" Variant="Primary"
                                        Command="{Binding ConfirmCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
    <!-- ============================ 未保存更改（保存 / 不保存 / 取消） ============================ -->
    <DataTemplate DataType="{x:Type vm:UnsavedChangesDialogViewModel}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource BlurDialogStyle}" MinWidth="340" MaxWidth="440" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Margin="0,10,0,18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <local:SOrButton Content="{Binding CancelText}" Variant="Ghost"
                                        Command="{Binding CancelCommand}" />
                        <local:SOrButton Content="{Binding DiscardText}" Variant="Secondary"
                                        Command="{Binding DiscardCommand}" Margin="10,0,0,0" />
                        <local:SOrButton Content="{Binding SaveText}" Variant="Primary"
                                        Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
