<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:SOrtus.Controls"
                      xmlns:vm="clr-namespace:SOrtus.ViewModels"
                      xmlns:core="clr-namespace:SOrtus.Core.Models;assembly=SOrtus.Core"
                      xmlns:conv="clr-namespace:SOrtus.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/Controls.Dialog.xaml" />
        <!-- 页面 / 版块入场样式（VD-063）与微交互节奏同源，StaticResource 需在本字典可见 -->
        <ResourceDictionary Source="Styles/Animations.xaml" />
    </ResourceDictionary.MergedDictionaries>



    <!-- 视图模型 -> 视图 映射（规范：简单内容区切换，DataTemplate 驱动，无重型框架）。 -->

    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
    <conv:TypeEqualsConverter x:Key="TypeEqualsConverter" />
    <conv:ProjectTypeDisplayConverter x:Key="ProjectTypeDisplayConverter" />
    <conv:ProjectStatusDisplayConverter x:Key="ProjectStatusDisplayConverter" />
    <conv:ProjectTypeToToneConverter x:Key="ProjectTypeToToneConverter" />
    <conv:ProjectStatusToToneConverter x:Key="ProjectStatusToToneConverter" />

    <!--
        页面入场动画（VD-063）：必须 BasedOn 隐式 SOrCard 样式。
        SOrCard 的模板只存在于隐式样式里（没有 generic.xaml），
        直接 Style="{StaticResource PageCardStyle}" 会把隐式样式顶掉，
        卡片失去 Template → 整页渲染为空。
    -->
    <Style x:Key="PageCardStyle" TargetType="local:SOrCard"
           BasedOn="{StaticResource {x:Type local:SOrCard}}">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="8" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource SlideUpStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- 下拉框通用：可空枚举 → 本地化文本 -->
    <DataTemplate x:Key="TypeItemTemplate">
        <TextBlock Text="{Binding Converter={StaticResource ProjectTypeDisplayConverter}}" />
    </DataTemplate>
    <DataTemplate x:Key="StatusItemTemplate">
        <TextBlock Text="{Binding Converter={StaticResource ProjectStatusDisplayConverter}}" />
    </DataTemplate>

    <!-- ============================ 立项列表 ============================ -->
    <DataTemplate DataType="{x:Type vm:ProjectListViewModel}">
        <!-- VD-063：页面入场（220ms 淡入 + 8px 上移），不再「闪切」 -->
        <local:SOrCard VerticalAlignment="Stretch" Style="{StaticResource PageCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          local:ScrollMemory.VerticalOffset="{Binding ScrollOffset, Mode=TwoWay}">
                <StackPanel>
                    <!-- 头部：标题 + 统计 + 新建 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- VD-120 / 旧单 VD-057：页面标题不再与导航项同名（旧版两处都是「立项」），
                                 导航回答「我在哪」，标题回答「这页是什么」 -->
                            <TextBlock Text="{DynamicResource List_Title}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
                            <!-- VD-056：副标题只留统计。「数据只留在本机」这类定位句已由空状态引导句承担，
                                 旧版同一句话在副标题和空状态各出现一次 -->
                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <local:SOrButton Grid.Column="1" Variant="Primary"
                                        Icon="{DynamicResource IconPlus}"
                                        Content="{DynamicResource List_NewButton}"
                                        Command="{Binding NewCommand}"
                                        VerticalAlignment="Center" />
                    </Grid>

                    <!-- 工具栏：搜索 / 类型筛选 / 状态筛选
                         VD-087（并入旧单 VD-056）：一个立项都没有时，搜索与两个筛选器全是空转，
                         留着只会让人以为「有数据但没显示出来」。空列表时整条工具栏隐藏，
                         页面只保留「新建」与引导句。 -->
                    <Grid Margin="0,0,0,12"
                          Style="{StaticResource SectionFadeInStyle}"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- VD-085：有内容时给一个 ×，不用逐字删 -->
                        <local:SOrTextBox Grid.Column="0" LeadingIcon="{DynamicResource IconSearch}"
                                          IsClearable="True"
                                          Placeholder="{DynamicResource List_SearchPlaceholder}"
                                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <local:SOrComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}"
                                          SelectedItem="{Binding FilterType}"
                                          ItemTemplate="{StaticResource TypeItemTemplate}"
                                          Placeholder="{DynamicResource List_TypeAll}"
                                          Margin="10,0,0,0" MinWidth="130" />
                        <local:SOrComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding FilterStatus}"
                                          ItemTemplate="{StaticResource StatusItemTemplate}"
                                          Placeholder="{DynamicResource List_StatusAll}"
                                          Margin="10,0,0,0" MinWidth="130" />
                    </Grid>

                    <!-- 列表 / 空状态 -->
                    <ItemsControl ItemsSource="{Binding Projects}"
                                  Visibility="{Binding Projects.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:SOrProjectListItem Project="{Binding}"
                                                          Margin="0,0,0,10"
                                                          OpenCommand="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态：完全没有任何立项（工具栏已隐藏，这里承担全部引导） -->
                    <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center" Margin="0,48,0,0">
                        <TextBlock Text="{DynamicResource List_Empty}" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource List_EmptyHint}" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <local:SOrButton Content="{DynamicResource List_NewButton}"
                                        Command="{Binding NewCommand}"
                                        Variant="Primary"
                                        Margin="0,16,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 空状态：有数据但被筛选过滤为空（VD-087：给出匹配数 + 一键清除筛选，
                         旧版只留一句话，用户只能自己逐个把筛选器改回「全部」） -->
                    <StackPanel Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center" Margin="0,48,0,0">
                        <TextBlock Text="{Binding NoResultsText}" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <local:SOrButton Content="{DynamicResource List_ClearFilter}"
                                        Command="{Binding ClearFiltersCommand}"
                                        Variant="Secondary"
                                        Margin="0,14,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </local:SOrCard>
    </DataTemplate>

    <!-- ============================ 立项向导（两步） ============================ -->
    <DataTemplate DataType="{x:Type vm:ProjectWizardViewModel}">
        <local:SOrCard VerticalAlignment="Stretch" Style="{StaticResource PageCardStyle}">
            <!-- 两行结构：内容滚动区 + 固定底部操作条（上一步永远在左下、下一步/创建永远在右下） -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- VD-059：去居中窄版心（旧版 MaxWidth=760 + Center），全宽排布；
                         窗口超过 ContentMaxWidth 时停在上限（左对齐，不居中），否则完全撑满 -->
                    <StackPanel MaxWidth="{DynamicResource ContentMaxWidth}" Margin="4,4,4,0">

                        <!-- 页头：标题 + 步骤指示器（VD-098）+ 说明文字
                             VD-120 / 旧单 VD-057：页面标题与导航项同名（都是「新建立项」）时，
                             用户无法判断自己是在「列表上方的位置」还是「新建流程里」。
                             标题改为带步骤的「新立项 · 1/2 选择类型」，导航项保持「新建立项」。
                             VD-098：旧版第 1 步只有一句介绍语、第 2 步才突然冒出「第 2 步」，
                             用户建立不起「总共几步 / 我在第几步」的模型。这里放固定步进器，
                             两步都保留自己的说明文字。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Wizard_TitleStepType}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                                           Visibility="{Binding IsStepType, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{DynamicResource Wizard_TitleStepInfo}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                                           Visibility="{Binding IsStepInfo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource Wizard_Step1Hint}" FontSize="{DynamicResource FontSizeLabel}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsStepType, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <!-- VD-097 延伸：提示文案按类型分支——剪辑 / 待办没有技术栈，不能跟着说「技术栈必填」。
                                         外层容器先按步骤收窄，内层再按类型二选一，避免与第 1 步的说明同时出现。 -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsStepInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource Wizard_Step2Hint}" FontSize="{DynamicResource FontSizeLabel}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{DynamicResource Wizard_Step2HintNoStack}" FontSize="{DynamicResource FontSizeLabel}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </StackPanel>
                                    <local:SOrTag Tone="Neutral" Margin="10,0,0,0"
                                                  Visibility="{Binding IsStepInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedTypeName, Mode=OneWay}" FontSize="{DynamicResource FontSizeCaption}" />
                                    </local:SOrTag>
                                </StackPanel>
                            </StackPanel>

                            <!-- 步进器：当前步实心 + 主色文字，另一步空心 + 次要色 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0"
                                        Visibility="{Binding IsStepType, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource PrimaryBrush}">
                                    <TextBlock Text="1" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{DynamicResource Wizard_StepType}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" />
                                <Rectangle Width="24" Height="1" Fill="{DynamicResource BorderStrongBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderStrongBrush}">
                                    <TextBlock Text="2" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{DynamicResource Wizard_StepInfo}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0"
                                        Visibility="{Binding IsStepInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderStrongBrush}">
                                    <TextBlock Text="1" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{DynamicResource Wizard_StepType}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Rectangle Width="24" Height="1" Fill="{DynamicResource BorderStrongBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource PrimaryBrush}">
                                    <TextBlock Text="2" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{DynamicResource Wizard_StepInfo}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,18" />

                        <!-- ============ 第 1 步：选择类型 ============ -->
                        <!-- VD-093：去掉 MinHeight=340——三张卡按最高的那张自适应，
                             不再让内容只占上面 60%、下面空 40% -->
                        <Grid Visibility="{Binding IsStepType, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <local:SOrButton Grid.Column="0" Variant="Card"
                                             HorizontalContentAlignment="Stretch" Padding="18"
                                             Margin="0,0,12,0" VerticalAlignment="Stretch"
                                             Command="{Binding SelectTypeCommand}"
                                             CommandParameter="{x:Static core:ProjectType.Programming}"
                                             IsActive="{Binding SelectedType, Converter={StaticResource TypeEqualsConverter}, ConverterParameter=Programming}">
                                <StackPanel VerticalAlignment="Top">
                                    <Border Width="40" Height="40" HorizontalAlignment="Left"
                                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                                            Background="{DynamicResource NavActiveBrush}">
                                        <Path Data="{DynamicResource IconCode}" Fill="{DynamicResource TextPrimaryBrush}"
                                              Width="20" Height="20" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource List_TypeProgramming}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSection}" Margin="0,14,0,6" />
                                    <TextBlock Text="{DynamicResource Wizard_TypeProgrammingDesc}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_ProgFeat1}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_ProgFeat2}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_ProgFeat3}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </local:SOrButton>

                            <local:SOrButton Grid.Column="1" Variant="Card"
                                             HorizontalContentAlignment="Stretch" Padding="18"
                                             Margin="0,0,12,0" VerticalAlignment="Stretch"
                                             Command="{Binding SelectTypeCommand}"
                                             CommandParameter="{x:Static core:ProjectType.Clip}"
                                             IsActive="{Binding SelectedType, Converter={StaticResource TypeEqualsConverter}, ConverterParameter=Clip}">
                                <StackPanel VerticalAlignment="Top">
                                    <Border Width="40" Height="40" HorizontalAlignment="Left"
                                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                                            Background="{DynamicResource NavActiveBrush}">
                                        <Path Data="{DynamicResource IconVideo}" Fill="{DynamicResource TextPrimaryBrush}"
                                              Width="20" Height="20" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource List_TypeClip}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSection}" Margin="0,14,0,6" />
                                    <TextBlock Text="{DynamicResource Wizard_TypeClipDesc}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_ClipFeat1}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_ClipFeat2}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_ClipFeat3}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </local:SOrButton>

                            <local:SOrButton Grid.Column="2" Variant="Card"
                                             HorizontalContentAlignment="Stretch" Padding="18"
                                             VerticalAlignment="Stretch"
                                             Command="{Binding SelectTypeCommand}"
                                             CommandParameter="{x:Static core:ProjectType.Todo}"
                                             IsActive="{Binding SelectedType, Converter={StaticResource TypeEqualsConverter}, ConverterParameter=Todo}">
                                <StackPanel VerticalAlignment="Top">
                                    <Border Width="40" Height="40" HorizontalAlignment="Left"
                                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                                            Background="{DynamicResource NavActiveBrush}">
                                        <Path Data="{DynamicResource IconTodo}" Fill="{DynamicResource TextPrimaryBrush}"
                                              Width="20" Height="20" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource List_TypeTodo}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSection}" Margin="0,14,0,6" />
                                    <TextBlock Text="{DynamicResource Wizard_TypeTodoDesc}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_TodoFeat1}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_TodoFeat2}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Wizard_TodoFeat3}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </local:SOrButton>
                        </Grid>

                        <!-- ============ 第 2 步：填写信息（VD-059：全宽 + 两张分组卡，卡内行式字段） ============ -->
                        <StackPanel Visibility="{Binding IsStepInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- 分组卡：基本信息 -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Wizard_CardBasic}" />
                                    </Border>

                                    <!-- 项目名字 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Name}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <local:SOrTextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                              local:FormField.Anchor="Name"
                                                              IsInvalid="{Binding HasNameError}"
                                                              Placeholder="{DynamicResource Wizard_NamePlaceholder}" />
                                            <TextBlock Text="{Binding NameError}" FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 简介 / 任务描述（标签按类型切换，控件共用） -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_TaskDesc}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0"
                                                   Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Summary}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0"
                                                   Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- 技术栈：仅编程类（编辑器需要整行宽度，不走标签列） -->
                                    <StackPanel Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource Wizard_TechStack}" FontWeight="Medium" FontSize="{DynamicResource FontSizeLabel}" />
                                        <TextBlock Text="{DynamicResource Wizard_TechStackPresets}" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,6" />
                                        <!-- VD-094：预设带「已选中」圆点标记——旧版预设与已选胶囊外观一致，
                                             用户分不清「这个是选中的预设」还是「这里还有一个待加标签」 -->
                                        <ItemsControl ItemsSource="{Binding TechStackPresets}" Margin="0,0,0,6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:SOrButton Variant="Secondary"
                                                                    IsActive="{Binding IsSelected}"
                                                                    FontSize="{DynamicResource FontSizeCaption}" FontWeight="Regular" Padding="12,6"
                                                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                                                    Margin="0,0,8,8"
                                                                    Command="{Binding DataContext.TogglePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                     Fill="{DynamicResource PrimaryBrush}"
                                                                     Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </local:SOrButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                            <local:SOrTextBox Text="{Binding TechStackInput, UpdateSourceTrigger=PropertyChanged}"
                                                              local:FormField.Anchor="TechStack"
                                                              IsInvalid="{Binding HasTechStackError}"
                                                              SubmitCommand="{Binding AddTechStackCommand}"
                                                              Placeholder="{DynamicResource Wizard_TechStackPlaceholder}"
                                                              MinWidth="300" />
                                            <!-- VD-096：纯「+」号既无文字也无 tooltip，36×36 的方块还压不住左侧长输入框；
                                                 改为「图标 + 添加」的次要按钮，语义直给 -->
                                            <local:SOrButton Command="{Binding AddTechStackCommand}"
                                                            Icon="{DynamicResource IconPlus}" IconSize="12"
                                                            Content="{DynamicResource Wizard_TechStackAdd}"
                                                            Variant="Secondary" Margin="8,0,0,0"
                                                            Padding="14,0" VerticalAlignment="Stretch" />
                                        </StackPanel>

                                        <!-- VD-094：「已选 N 项」小标题把预设区与已选区串起来（旧版两块各说各话） -->
                                        <TextBlock Text="{Binding SelectedTechStackCountText}" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,6" />
                                        <ItemsControl ItemsSource="{Binding TechStacks}" Margin="0,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:SOrTag Margin="0,0,8,8" Tone="AccentA">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" />
                                                            <local:SOrButton Content="✕" Variant="Ghost" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Regular"
                                                                            Padding="6,0" Margin="4,0,0,0" ToolTip="{DynamicResource Detail_Delete}"
                                                                            Command="{Binding DataContext.RemoveTechStackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </local:SOrTag>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding TechStackError}" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasTechStackError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 分组卡：归属与工期 -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Wizard_CardOwnership}" />
                                    </Border>

                                    <!-- 子类型：编程=项目类型，剪辑=剪辑类型（待办不展示） -->
                                    <Grid Margin="0,0,0,12"
                                          Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_SubType}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_ClipType}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding IsClip, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Column="1">
                                            <local:SOrComboBox ItemsSource="{Binding SubTypeOptions}" SelectedItem="{Binding SubType}"
                                                               local:FormField.Anchor="SubType"
                                                               IsInvalid="{Binding HasClipTypeError}" />
                                            <TextBlock Text="{Binding ClipTypeError}" FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasClipTypeError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 关联文件夹：编程=关联文件夹，剪辑=素材文件夹（待办不展示） -->
                                    <Grid Margin="0,0,0,12"
                                          Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Folder}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_MaterialFolder}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding IsClip, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:SOrTextBox Grid.Column="0"
                                                             Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                             Placeholder="{DynamicResource Wizard_FolderPlaceholder}" />
                                            <local:SOrButton Grid.Column="1" Command="{Binding BrowseFolderCommand}"
                                                            Content="{DynamicResource Wizard_FolderBrowse}"
                                                            Variant="Secondary" Margin="8,0,0,0"
                                                            Padding="16,0" VerticalAlignment="Stretch" />
                                        </Grid>
                                    </Grid>

                                    <!-- 工期：编程 / 剪辑（起止日期各配字段标签，VD-007 保留） -->
                                    <StackPanel Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Schedule}" FontWeight="Medium"
                                                       FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                            <!-- VD-095：两个日期框改为等分铺满 + 「至」连字符。
                                                 旧版固定 196 宽，右缘比同列其它输入框短一大截，形成锯齿；
                                                 而且「2026年10月25日」贴着边，几乎没有余量。 -->
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Wizard_DateStart}" FontWeight="Medium" FontSize="{DynamicResource FontSizeLabel}" Margin="0,0,0,4" />
                                                    <local:SOrDatePicker SelectedDate="{Binding ScheduleStart}"
                                                                         local:FormField.Anchor="Schedule"
                                                                         IsInvalid="{Binding HasScheduleError}"
                                                                         HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{DynamicResource Wizard_DateTo}" Margin="10,20,10,0"
                                                           VerticalAlignment="Top"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource FontSizeLabel}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Wizard_DateEnd}" FontWeight="Medium" FontSize="{DynamicResource FontSizeLabel}" Margin="0,0,0,4" />
                                                    <local:SOrDatePicker SelectedDate="{Binding ScheduleEnd}"
                                                                         IsInvalid="{Binding HasScheduleError}"
                                                                         HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        <!-- 字段级错误：就近字段展示（VD-008 保留） -->
                                        <TextBlock Text="{Binding ScheduleError}" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasScheduleError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <!-- 完成时间：仅待办 -->
                                    <Grid Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_DueTime}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <local:SOrDatePicker SelectedDate="{Binding ScheduleEnd}"
                                                                 local:FormField.Anchor="ScheduleEnd"
                                                                 IsInvalid="{Binding HasDueTimeError}"
                                                                 HorizontalAlignment="Left" Width="240" />
                                            <TextBlock Text="{Binding DueTimeError}" FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasDueTimeError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 固定操作条：取消 / 上一步（左下） · 错误汇总 · 下一步 / 创建（右下） -->
                <Grid Grid.Row="1" Margin="4,18,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- VD-092：旧版页脚只有「上一步 / 创建」，没有取消入口（Wizard_Cancel 文案写了却从未渲染）。
                         取消与详情页的「返回」同级：Ghost 弱化，但必须有。 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <local:SOrButton Variant="Ghost" Content="{DynamicResource Wizard_Cancel}"
                                         Command="{Binding CancelCommand}" Padding="14,10"
                                         Margin="0,0,6,0" />
                        <local:SOrButton Variant="Ghost" Icon="{DynamicResource IconBack}"
                                         Content="{DynamicResource Wizard_Back}" Padding="14,10"
                                         Command="{Binding PreviousStepCommand}"
                                         Visibility="{Binding IsStepInfo, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorDetail}" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <local:SOrButton Grid.Column="2" Variant="Primary" Content="{DynamicResource Wizard_Next}"
                                    Command="{Binding NextStepCommand}" Padding="28,10" MinWidth="120"
                                    Visibility="{Binding IsStepType, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <local:SOrButton Grid.Column="2" Variant="Primary" Content="{DynamicResource Wizard_Create}"
                                    Command="{Binding CreateCommand}" Padding="28,10" MinWidth="120"
                                    Visibility="{Binding IsStepInfo, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </local:SOrCard>
    </DataTemplate>

    <!-- ============================ 立项详情（V2：基础信息 / 开发管理 / GIT 管理） ============================ -->
    <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
        <local:SOrCard VerticalAlignment="Stretch" Style="{StaticResource PageCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部：返回 + 标题。
                     VD-105：名称超长会省略，必须给 ToolTip，否则页面最重要的识别信息
                     （这是哪个立项）一旦被截断就再也看不全。
                     VD-102：未保存徽标已移到页脚保存按钮左侧——它与保存动作在同一条视线里，
                     不再与标题绑在一起、又离页脚状态行 700px。 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:SOrButton Grid.Column="0" Variant="Ghost" Icon="{DynamicResource IconBack}"
                                     Command="{Binding BackCommand}" Padding="12,9" />
                    <TextBlock Grid.Column="1" Text="{Binding Project.Name}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Project.Name}" />
                </Grid>

                <!-- 版块切换（仅编程类型）
                     VD-100：旧版复用 Nav 变体——未选中无边框无下划线、选中只是灰底块，
                     三个词看起来像三个标签而不是可切换 tab；且与下方卡片标题同名同大小。
                     现在用 Tab 变体（次要色文字 + 底部 2px 指示条），卡片标题另行改名。 -->
                <Border Grid.Row="1"
                        Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <local:SOrButton Content="{DynamicResource Detail_SectionBasic}" Variant="Tab"
                                         Command="{Binding SelectSectionCommand}" CommandParameter="Basic"
                                         IsActive="{Binding ActiveSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Basic}"
                                         Margin="0,0,4,0" />
                        <local:SOrButton Content="{DynamicResource Detail_SectionDev}" Variant="Tab"
                                         Command="{Binding SelectSectionCommand}" CommandParameter="Dev"
                                         IsActive="{Binding ActiveSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dev}"
                                         Margin="0,0,4,0" />
                        <local:SOrButton Content="{DynamicResource Detail_SectionGit}" Variant="Tab"
                                         Command="{Binding SelectSectionCommand}" CommandParameter="Git"
                                         IsActive="{Binding ActiveSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Git}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              local:ScrollReset.Trigger="{Binding ActiveSection}">
                    <!-- VD-059：去居中窄版心（旧版各版块 MaxWidth=760 + Center），全宽 + 分组卡片行式字段；
                         窗口超过 ContentMaxWidth 时停在上限（左对齐，不居中），否则完全撑满 -->
                    <StackPanel MaxWidth="{DynamicResource ContentMaxWidth}" Margin="0,14,4,0">

                        <!-- ===== 基础信息 ===== -->
                        <StackPanel Style="{StaticResource SectionFadeInStyle}" Visibility="{Binding ShowBasicSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- 分组卡：基本信息 -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Detail_Basic}" />
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Name}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Summary}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.Summary, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Progress}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:SOrSlider Grid.Column="0" Minimum="0" Maximum="100"
                                                             Value="{Binding Project.ProgressPercent}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding Project.ProgressPercent, StringFormat={}{0:0}%}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 分组卡：类型与归属 -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Detail_CardOwnership}" />
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Version}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                                                          Placeholder="{DynamicResource Detail_VersionPlaceholder}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Status}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <local:SOrComboBox ItemsSource="{Binding StatusOptions}"
                                                              SelectedItem="{Binding Status}"
                                                              ItemTemplate="{StaticResource StatusItemTemplate}"
                                                              MinWidth="140" />
                                            <local:SOrTag Margin="10,0,0,0"
                                                          Tone="{Binding Project.Type, Converter={StaticResource ProjectTypeToToneConverter}}">
                                                <TextBlock Text="{Binding Project.Type, Converter={StaticResource ProjectTypeDisplayConverter}}" FontSize="{DynamicResource FontSizeCaption}" />
                                            </local:SOrTag>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_SubType}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <local:SOrComboBox Grid.Column="1" ItemsSource="{Binding SubTypeOptions}" SelectedItem="{Binding SubType}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Folder}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 分组卡：技术栈（胶囊编辑，编程类型） -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Wizard_TechStack}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TechStackChips}" Margin="0,0,0,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource TagAccentABgBrush}"
                                                        CornerRadius="{DynamicResource CornerRadiusSmall}"
                                                        Padding="10,4" Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TagAccentAFgBrush}" />
                                                        <!-- VD-104：删除命中区补到 24×24，用图标而非「×」字符。
                                                             旧版是 13px 小字 + 负 margin 压住 chip 边缘，
                                                             手指/触控板很难点准，误删又没有撤销。 -->
                                                        <local:SOrButton Variant="Ghost" Icon="{DynamicResource IconClose}" IconSize="10"
                                                                         Width="24" Height="24" Padding="0"
                                                                         Margin="4,-2,0,0" ToolTip="{DynamicResource Detail_TechRemove}"
                                                                         Command="{Binding DataContext.RemoveTechStackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                         CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:SOrTextBox Grid.Column="0"
                                                          Text="{Binding NewTechStack, UpdateSourceTrigger=PropertyChanged}"
                                                          Placeholder="{DynamicResource Detail_TechAddPlaceholder}"
                                                          SubmitCommand="{Binding AddTechStackCommand}" />
                                        <local:SOrButton Grid.Column="1" Content="{DynamicResource Detail_TechAdd}"
                                                         Variant="Secondary" Command="{Binding AddTechStackCommand}"
                                                         Margin="8,0,0,0" Padding="16,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== 开发管理 ===== -->
                        <StackPanel Style="{StaticResource SectionFadeInStyle}" Visibility="{Binding ShowDevSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- 分组卡：规划与目标（VD-103：卡片标题不再与首字段标签同为「开发规划」，
                                 旧版连续两行同一个词，一行灰一行黑，读者以为是「分组 + 字段」，其实两句话一样） -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Detail_CardDevPlan}" />
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_DevPlan}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.DevPlan, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Constraints}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.Constraints, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Goals}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.Goals, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Acceptance}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.AcceptanceCriteria, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 分组卡：项目文档（PRD / 迭代规划为单槽位，其他文档多份并存） -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Detail_CardDocuments}" />
                                    </Border>

                                    <!-- 文档操作反馈 -->
                                    <Border Background="{DynamicResource TagDangerBgBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                            Padding="10,6" Margin="0,0,0,10"
                                            Visibility="{Binding HasDocumentError, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding DocumentError}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TagDangerFgBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource TagSuccessBgBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                            Padding="10,6" Margin="0,0,0,10"
                                            Visibility="{Binding HasDocumentStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding DocumentStatus}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TagSuccessFgBrush}" />
                                    </Border>

                                    <!-- PRD（单槽位） -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Doc_PrdTitle}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Visibility="{Binding HasPrd, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:SOrTag Tone="AccentA" Content="{Binding PrdDocument.FormatLabel}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding PrdDocument.Title}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PrdMetaText}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <local:SOrButton Content="{DynamicResource Doc_Open}" Variant="Secondary"
                                                                     Command="{Binding OpenDocumentCommand}" CommandParameter="{Binding PrdDocument}" />
                                                    <local:SOrButton Content="{DynamicResource Doc_Replace}" Variant="Ghost"
                                                                     Command="{Binding ImportPrdCommand}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding IsPrdEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource Doc_EmptyHint}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                <local:SOrButton Content="{DynamicResource Doc_Import}" Variant="Secondary"
                                                                 HorizontalAlignment="Left"
                                                                 Command="{Binding ImportPrdCommand}"
                                                                 IsEnabled="{Binding IsDocumentFeatureAvailable}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 版本迭代规划（单槽位） -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Doc_PlanTitle}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:SOrTag Tone="AccentB" Content="{Binding PlanDocument.FormatLabel}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding PlanDocument.Title}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PlanMetaText}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <local:SOrButton Content="{DynamicResource Doc_Open}" Variant="Secondary"
                                                                     Command="{Binding OpenDocumentCommand}" CommandParameter="{Binding PlanDocument}" />
                                                    <local:SOrButton Content="{DynamicResource Doc_Replace}" Variant="Ghost"
                                                                     Command="{Binding ImportPlanCommand}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding IsPlanEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource Doc_EmptyHint}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                <local:SOrButton Content="{DynamicResource Doc_Import}" Variant="Secondary"
                                                                 HorizontalAlignment="Left"
                                                                 Command="{Binding ImportPlanCommand}"
                                                                 IsEnabled="{Binding IsDocumentFeatureAvailable}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 其他文档（多份列表） -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Doc_OtherTitle}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Doc_OtherHint}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,8"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            <local:SOrButton Content="{DynamicResource Doc_Import}" Variant="Secondary"
                                                             Command="{Binding ImportOtherCommand}" HorizontalAlignment="Left"
                                                             IsEnabled="{Binding IsDocumentFeatureAvailable}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding OtherDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusMedium}"
                                                        Padding="12" Margin="0,8,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <local:SOrTag Tone="Neutral" Content="{Binding Format}" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SourceFileName}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <local:SOrButton Content="{DynamicResource Doc_Open}" Variant="Secondary"
                                                                             Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding}" />
                                                            <local:SOrButton Content="{DynamicResource Common_Delete}" Variant="Danger"
                                                                             Margin="6,0,0,0"
                                                                             Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{DynamicResource Doc_EmptyOther}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsOtherDocumentsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== GIT 管理 ===== -->
                        <Border Style="{StaticResource GroupCardStyle}"
                                Visibility="{Binding ShowGitSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Style="{StaticResource SectionFadeInStyle}">
                                <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Detail_SectionGit}" />
                                    </Border>
                                <ContentControl Content="{Binding Git}" />
                            </StackPanel>
                        </Border>

                        <!-- ===== 危险区（VD-101）：删除移出页脚 =====
                             旧版把红色实心「删除」和最高频的「保存」放进同一条 40px 页脚、
                             中间只隔时间戳——鼠标从保存滑到删除只差 600px，而删除不可撤销。
                             现在删除沉到页面最底部：分隔线 + 一句「影响与不可撤销」的说明 + 描边红按钮，
                             页脚只保留保存与状态。 -->
                        <Border Style="{StaticResource GroupCardStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource CardTitleBorderStyle}">
                                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Detail_DangerZoneTitle}" />
                                </Border>
                                <TextBlock Text="{DynamicResource Detail_DangerZoneHint}" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,12" MaxWidth="560" />
                                <local:SOrButton Content="{DynamicResource Detail_Delete}" Variant="Danger"
                                                 Command="{Binding DeleteCommand}" HorizontalAlignment="Left" Padding="18,9" />
                            </StackPanel>
                        </Border>

                        <!-- ===== 剪辑 / 待办：按类型派生版块（VD-059：废弃「遗留单栏」全字段平铺；
                             标签按类型派生——剪辑=剪辑类型/素材文件夹（SO-009）；
                             技术栈不再以分号串文本框编辑，剪辑/待办不展示该字段（SO-014）） ===== -->
                        <StackPanel Style="{StaticResource SectionFadeInStyle}" Visibility="{Binding ShowLegacySection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- 分组卡：基本信息 -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Detail_Basic}" />
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Name}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!-- 简介 / 任务描述（待办=任务描述，剪辑=简介） -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_TaskDesc}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0"
                                                   Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Summary}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0"
                                                   Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.Summary, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- 子类型：仅剪辑（待办无选项，隐藏） -->
                                    <Grid Margin="0,0,0,12"
                                          Visibility="{Binding HasSubTypeOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_ClipType}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <local:SOrComboBox Grid.Column="1" ItemsSource="{Binding SubTypeOptions}" SelectedItem="{Binding SubType}" />
                                    </Grid>

                                    <!-- 文件夹：剪辑=素材文件夹，待办=关联文件夹 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_MaterialFolder}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding IsClip, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Wizard_Folder}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Progress}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:SOrSlider Grid.Column="0" Minimum="0" Maximum="100"
                                                             Value="{Binding Project.ProgressPercent}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding Project.ProgressPercent, StringFormat={}{0:0}%}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 分组卡：规划与约束 -->
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Detail_CardPlanning}" />
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_DevPlan}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.DevPlan, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Constraints}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.Constraints, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Goals}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.Goals, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Detail_Acceptance}" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <local:SOrTextBox Grid.Column="1" Text="{Binding Project.AcceptanceCriteria, UpdateSourceTrigger=PropertyChanged}"
                                                          AcceptsReturn="True" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 页脚（VD-101 / VD-102）：保存（左）+ 未保存徽标（紧邻保存）/ 状态 + 撤销（中）/ 时间戳（右）。
                     删除已移出页脚进页面底部危险区，这里只保留「日常高频」的那一组动作与状态。 -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:SOrButton Grid.Column="0" Content="{Binding SaveButtonText}" Variant="Primary"
                                     Command="{Binding SaveCommand}" Padding="22,10" VerticalAlignment="Center" />
                    <local:SOrTag Grid.Column="1" Tone="Warning" Content="{DynamicResource Detail_UnsavedBadge}"
                                  Margin="10,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel Grid.Column="2" Margin="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FontSizeCaption}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <local:SOrButton Content="{DynamicResource Detail_UndoRemove}" Variant="Ghost"
                                             FontSize="{DynamicResource FontSizeCaption}" Padding="8,4" Margin="8,0,0,0"
                                             Command="{Binding UndoRemoveTechStackCommand}"
                                             Visibility="{Binding CanUndoRemoveTechStack, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <!-- VD-119：主文案一句话 + 技术细节降级为小字，不把异常原文塞进主句 -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ErrorDetail}" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="360"
                                       Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="3" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0">
                        <Run Text="{Binding CreatedText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Grid>
        </local:SOrCard>
    </DataTemplate>

    <!-- ============================ GIT 管理版块 ============================ -->
    <DataTemplate DataType="{x:Type vm:GitViewModel}">
        <StackPanel>
            <!-- 工具条：当前分支 / 领先落后 / 远端状态 + 操作 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <local:SOrTag Tone="AccentB">
                        <TextBlock Text="{Binding CurrentBranch}" FontSize="{DynamicResource FontSizeCaption}" />
                    </local:SOrTag>
                    <local:SOrTag Tone="Warning" Margin="8,0,0,0"
                                  Visibility="{Binding HasAhead, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding AheadText}" FontSize="{DynamicResource FontSizeCaption}" />
                    </local:SOrTag>
                    <local:SOrTag Tone="Neutral" Margin="8,0,0,0"
                                  Visibility="{Binding HasBehind, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding BehindText}" FontSize="{DynamicResource FontSizeCaption}" />
                    </local:SOrTag>
                    <local:SOrTag Tone="Danger" Margin="8,0,0,0"
                                  Visibility="{Binding NoRemote, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Content="{DynamicResource Git_NoRemote}" FontSize="{DynamicResource FontSizeCaption}" />
                </StackPanel>
                <!--
                    操作区（VD-106 / 旧单 VD-022 · VD-053 · VD-054）：
                    旧版三个按钮只有文字（「刷新 / 添加远端地址 / 推送至云端」），
                     · 刷新借用了 IconSearch 的放大镜（语义错位）；
                     · 添加远端与推送无图标，与刷新并排时三者视觉权重全等；
                     · 「推送至云端」四个字把动作描述成了结果，还比「添加远端地址」更长，工具条被文字撑开。
                    现在：图标 + 短标签，主次按「推送 > 添加远端 > 刷新」排列，
                    刷新降为图标按钮（ToolTip 补全语义）并靠最右——它是最高频、最不需要读字的动作。
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <local:SOrButton Content="{DynamicResource Git_Push}" Variant="Primary"
                                     Icon="{DynamicResource IconCloudUpload}" IconSize="14"
                                     Command="{Binding PushCommand}" />
                    <local:SOrButton Content="{DynamicResource Git_AddRemote}" Variant="Secondary" Margin="8,0,0,0"
                                     Icon="{DynamicResource IconLink}" IconSize="14"
                                     Command="{Binding AddRemoteCommand}" />
                    <local:SOrButton Variant="Ghost" Margin="4,0,0,0" Padding="10,8"
                                     Icon="{DynamicResource IconRefresh}" IconSize="15"
                                     ToolTip="{DynamicResource Git_Refresh}"
                                     Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource TagDangerBgBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Padding="10,6" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TagDangerFgBrush}" />
                    <TextBlock Text="{Binding RawOutput}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasRawOutput, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource TagSuccessBgBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Padding="10,6" Margin="0,0,0,10"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TagSuccessFgBrush}" />
            </Border>

            <!-- 分支 -->
            <TextBlock Text="{DynamicResource Git_Branches}" FontWeight="Medium" FontSize="{DynamicResource FontSizeLabel}" Margin="0,4,0,6" />
            <ItemsControl ItemsSource="{Binding Branches}" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:SOrTag Tone="{Binding Tone}" Margin="0,0,8,8" ToolTip="{Binding TipSubject}">
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeCaption}" />
                        </local:SOrTag>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 时间线（VD-006：不再内嵌 ScrollViewer + MaxHeight 双层滚动，统一由外层页面滚动承载） -->
            <TextBlock Text="{DynamicResource Git_Timeline}" FontWeight="Medium" FontSize="{DynamicResource FontSizeLabel}" Margin="0,4,0,8" />
            <ItemsControl ItemsSource="{Binding Timeline}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="2" HorizontalAlignment="Center"
                                        Background="{DynamicResource PrimaryBrush}" Opacity="0.45"
                                        Visibility="{Binding ShowTopLine, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Border Grid.Row="1" Width="2" HorizontalAlignment="Center"
                                        Background="{DynamicResource PrimaryBrush}" Opacity="0.45"
                                        Visibility="{Binding ShowBottomLine, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Border Grid.RowSpan="2" Width="10" Height="10" CornerRadius="5"
                                        VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,7,0,0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,16">
                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ShortSha}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text=" · " FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Author}" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text=" · " FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WhenText}" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Refs}" Margin="0,6,0,0"
                                              Visibility="{Binding HasRefs, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:SOrTag Tone="AccentA" Margin="0,0,6,0" Padding="8,1">
                                                <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeCaption}" />
                                            </local:SOrTag>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- VD-107：时间线末尾补「查看更早 + 共 N 条」。
                 旧版时间线渲染完就留 400px 空白，用户分不清「只有这些提交」还是「加载失败/被截断」。 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                        Visibility="{Binding HasMoreCommits, Converter={StaticResource BoolToVisibilityConverter}}">
                <local:SOrButton Content="{Binding MoreCommitsText}" Variant="Ghost"
                                 Command="{Binding ShowMoreCommitsCommand}" Padding="12,8" />
            </StackPanel>
            <TextBlock Text="{Binding TimelineSummaryText}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"
                       Visibility="{Binding HasCommits, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{DynamicResource Git_EmptyRepo}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding IsEmptyRepository, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ============================ 文档预览弹窗 ============================ -->
    <DataTemplate DataType="{x:Type vm:DocumentDialogViewModel}">
        <Border Style="{StaticResource BlurDialogStyle}" Width="880" MaxHeight="660" Padding="0">
            <Grid Margin="24,20,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏：格式徽标 + 标题 + 来源文件 + 关闭 -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:SOrTag Grid.Column="0" Tone="AccentA" Content="{Binding FormatLabel}"
                                  VerticalAlignment="Center" Margin="0,2,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeSection}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SourceFileText}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- VD-114：右上角 × 从 16px 提到 20px（16px 在磨砂底上几乎与背景同色） -->
                    <local:SOrButton Grid.Column="2" Variant="Ghost" Icon="{DynamicResource IconClose}"
                                     IconSize="20" Command="{Binding CloseCommand}"
                                     ToolTip="{DynamicResource Common_Close}" Padding="10,8"
                                     VerticalAlignment="Top" />
                </Grid>

                <!-- 正文：FlowDocumentScrollViewer 负责连续滚动与文本选择 -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,14">
                    <FlowDocumentScrollViewer Document="{Binding Document}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsToolBarVisible="False"
                                              IsSelectionEnabled="True"
                                              MaxHeight="430"
                                              ScrollViewer.PanningMode="VerticalOnly"
                                              ScrollViewer.IsDeferredScrollingEnabled="False" />
                </Border>

                <!-- 页脚：自动保存状态 + 错误提示 + 关闭（VD-114）。
                     读完长文档视线停在底部，此处必须有出口——旧版唯一出口是右上角 16px 的 ×。 -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SaveStateText}" FontSize="{DynamicResource FontSizeCaption}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"
                               HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="420"
                               Foreground="{DynamicResource TagDangerFgBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <local:SOrButton Grid.Column="2" Content="{DynamicResource Common_Close}" Variant="Secondary"
                                     Command="{Binding CloseCommand}" Padding="18,9" Margin="12,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================ 配置远端弹窗 ============================ -->
    <DataTemplate DataType="{x:Type vm:AddRemoteDialogViewModel}">
        <Border Style="{StaticResource BlurDialogStyle}" Width="520" Padding="0">
            <StackPanel Margin="24,20,24,20">
                <TextBlock Text="{DynamicResource Git_AddRemoteTitle}" FontSize="{DynamicResource FontSizeSection}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Git_AddRemoteHint}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

                <TextBlock Text="{DynamicResource Git_RemoteName}" FontWeight="Medium" FontSize="{DynamicResource FontSizeLabel}" />
                <local:SOrTextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                <TextBlock Text="{DynamicResource Git_RemoteUrl}" FontWeight="Medium" FontSize="{DynamicResource FontSizeLabel}" />
                <local:SOrTextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                  Placeholder="{DynamicResource Git_RemoteUrlPlaceholder}" Margin="0,6,0,8" />

                <TextBlock Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TagDangerFgBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- VD-083：Esc 第一次只拦下并提示，第二次才放弃（遮罩点击对本弹窗无效） -->
                <TextBlock Text="{DynamicResource Dialog_EscDiscardHint}" FontSize="{DynamicResource FontSizeCaption}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TagWarningFgBrush}"
                           Visibility="{Binding ShowEscHint, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <local:SOrButton Content="{DynamicResource Common_Cancel}" Variant="Secondary"
                                     Command="{Binding CloseCommand}" Padding="18,9" />
                    <local:SOrButton Content="{DynamicResource Git_Confirm}" Variant="Primary"
                                     Command="{Binding ConfirmCommand}" Margin="10,0,0,0" Padding="18,9" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================ 设置 ============================ -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <local:SOrCard VerticalAlignment="Stretch" Style="{StaticResource PageCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <!-- VD-059：去居中窄版心（旧版 MaxWidth=760 + Center），改全宽 + 分组卡片行式排布；
                     窗口超过 ContentMaxWidth 时停在上限（左对齐，不居中），否则完全撑满，不再有居中窄条观感 -->
                <StackPanel MaxWidth="{DynamicResource ContentMaxWidth}" Margin="4">
                    <TextBlock Text="{DynamicResource Settings_Title}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Margin="0,0,0,18" />

                    <!-- 分组卡：外观 -->
                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Settings_Appearance}" />
                                    </Border>

                            <!-- 行式字段：标签列（固定 160）+ 控件列 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Settings_Theme}" FontWeight="Medium"
                                           FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <local:SOrComboBox Grid.Column="1" HorizontalAlignment="Left" MaxWidth="320"
                                                  ItemsSource="{Binding ThemeOptions}"
                                                  SelectedValue="{Binding CurrentTheme}" SelectedValuePath="Value"
                                                  DisplayMemberPath="Display" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Settings_Blur}" FontWeight="Medium"
                                           FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:SOrSlider Grid.Column="0" Minimum="0" Maximum="30"
                                                         Value="{Binding BlurRadius}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding BlurSummary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Settings_BlurLiveHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!-- 显示焦点框（用户需求 1）：默认开。属于视觉表现，跟主题/模糊同组；
                                 关掉只去掉额外强调环，输入框描边与光标仍在，键盘焦点依旧可辨。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Settings_FocusRing}" FontWeight="Medium"
                                           FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <local:SOrToggleSwitch IsChecked="{Binding ShowFocusRing, Mode=TwoWay}"
                                                               VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FocusRingStateText}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_FocusRingHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 分组卡：语言 -->
                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Settings_Language}" />
                                    </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Settings_UiLanguage}" FontWeight="Medium"
                                           FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <local:SOrComboBox HorizontalAlignment="Left" MaxWidth="320"
                                                      ItemsSource="{Binding LanguageOptions}"
                                                      SelectedValue="{Binding CurrentLanguage}" SelectedValuePath="Value"
                                                      DisplayMemberPath="Display" />
                                    <TextBlock Text="{Binding LanguageSoonHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 分组卡：数据 -->
                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Settings_Data}" />
                                    </Border>
                            <!-- VD-112：数据库路径改单行省略 + ToolTip 全路径。
                                 旧版整行铺开，把「数据库位置」这一行撑成其它行的 3 倍高，
                                 长路径还把卡片右半边占满；而这条信息 95% 的用户只在备份时才需要。
                                 全路径改由「复制路径」给出（Tooltip 也能看到），两个动作并排齐平。 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Settings_DbPathLabel}" FontWeight="Medium"
                                           FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DatabasePath}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTip="{Binding DatabasePath}" Margin="0,0,0,8"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <local:SOrButton Content="{DynamicResource Settings_OpenFolder}" Variant="Secondary"
                                                         Command="{Binding OpenDatabaseFolderCommand}" Padding="16,8" />
                                        <local:SOrButton Content="{DynamicResource Settings_CopyPath}" Variant="Ghost"
                                                         Command="{Binding CopyDatabasePathCommand}" Padding="16,8" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource Settings_AboutLocal}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{DynamicResource Settings_AboutLicense}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 分组卡：软件更新（手动检查入口，将来「关于」页复用同一命令） -->
                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource CardTitleBorderStyle}">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{DynamicResource Settings_Update}" />
                                    </Border>

                            <!-- 当前版本 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Settings_CurrentVersionLabel}" FontWeight="Medium"
                                           FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentVersionText}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <!-- 自动检查开关（VD-108）：状态用开关表达，不再让按钮文字承担「已开启/已关闭」。
                                 按钮 = 执行动作，开关 = 保持状态；同一页上面是下拉框、下面是滑块，
                                 唯独这里用按钮，控件语义不成体系。 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AutoCheck}" FontWeight="Medium"
                                           FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <local:SOrToggleSwitch IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}"
                                                               VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AutoCheckStateText}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" FontWeight="Medium"
                                                   FontSize="{DynamicResource FontSizeLabel}" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_AutoCheckHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>

                            <!-- 显示焦点框已移到「外观」分组：它属于视觉表现，不该藏在软件更新里 -->

                            <!-- 手动检查（VD-111）：补标签「手动检查」。
                                 旧版这一行左列 160px 完全空白，按钮孤零零悬在值列，
                                 看起来像漏了标题，又像属于上一行。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Settings_CheckNowLabel}" FontWeight="Medium"
                                           FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <local:SOrButton Content="{DynamicResource Settings_CheckNow}" Variant="Secondary"
                                                     Command="{Binding CheckUpdatesCommand}" Padding="16,8" />
                                    <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="360"
                                               Visibility="{Binding IsUpdateStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </local:SOrCard>
    </DataTemplate>

    <!-- ============================ 更新详情（覆盖层） ============================ -->
    <DataTemplate DataType="{x:Type vm:UpdateViewModel}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource BlurDialogStyle}" MinWidth="480" MaxWidth="580" Padding="0">
                <StackPanel Margin="24">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />

                    <!-- 版本对比 + 安装包体积 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding IsSizeVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                                   Visibility="{Binding IsSizeVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- 更新说明：限高滚动，避免长 changelog 把按钮顶出屏幕 -->
                    <TextBlock Text="{Binding NotesTitle}" Margin="0,16,0,6"
                               FontWeight="Medium" FontSize="{DynamicResource FontSizeLabel}" />
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusMedium}" Padding="12">
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSizeCaption}" />
                        </ScrollViewer>
                    </Border>

                    <!-- 下载进度 -->
                    <local:SOrProgressBar Margin="0,14,0,0" Height="6" Minimum="0" Maximum="100"
                                          Value="{Binding ProgressValue}"
                                          Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- 状态文案：下载百分比 / 校验中 / 失败原因 -->
                    <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSizeCaption}" />

                    <!-- VD-115：四个按钮挤在一行，其中「跳过此版本」与「稍后提醒」都是「现在不装」，
                         用户必须停下来分辨二者差别——按钮越多，主操作的确定性越低。
                         现在只留「稍后」(Ghost) +「下载并安装」(Primary)；
                         「不再提示此版本」降为次级文字动作，「打开发布页」移到标题下方的小链接。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <local:SOrButton Content="{Binding OpenPageText}" Variant="Ghost"
                                        Command="{Binding OpenPageCommand}" Padding="12,7"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Visibility="{Binding IsOpenPageVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <local:SOrButton Content="{Binding SkipText}" Variant="Ghost"
                                        Command="{Binding SkipCommand}" IsEnabled="{Binding CanSkip}"
                                        Margin="8,0,0,0" Padding="12,7"
                                        FontSize="{DynamicResource FontSizeCaption}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <local:SOrButton Content="{Binding LaterText}" Variant="Ghost"
                                        Command="{Binding LaterCommand}" Margin="8,0,0,0" Padding="16,9" />
                        <local:SOrButton Content="{Binding PrimaryActionText}" Variant="Primary"
                                        Command="{Binding PrimaryActionCommand}"
                                        IsEnabled="{Binding CanStartInstall}"
                                        Margin="10,0,0,0" Padding="18,9" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================ 确认 / 提示对话框 ============================ -->
    <!-- 确认 / 提示对话框。
         VD-117：破坏性操作（删除立项 / 删除文档）用同一模板但主按钮换危险样式、
         标题左侧加危险图标、且不设 IsDefault——默认焦点落在「取消」上，Enter 不会误触删除。
         VD-118：「取消」统一 Secondary（有边），不再出现一处 Secondary、一处 Ghost。 -->
    <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource BlurDialogStyle}" MinWidth="320" MaxWidth="420" Padding="0">
                <StackPanel Margin="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="!" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0"
                                   Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{DynamicResource FontSizeSection}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding Message}" Margin="0,10,0,18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <local:SOrButton Content="{Binding CancelText}" Variant="Secondary"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <local:SOrButton Content="{Binding ConfirmText}" Margin="10,0,0,0"
                                        IsDestructive="{Binding IsDestructive}"
                                        Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
    <!-- ============================ 未保存更改（保存 / 不保存 / 取消） ============================ -->
    <DataTemplate DataType="{x:Type vm:UnsavedChangesDialogViewModel}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource BlurDialogStyle}" MinWidth="340" MaxWidth="440" Padding="0">
                <StackPanel Margin="24">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeSection}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Margin="0,10,0,18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- VD-118：取消与普通确认统一为 Secondary（有边），不再一处 Secondary 一处 Ghost -->
                        <local:SOrButton Content="{Binding CancelText}" Variant="Secondary"
                                        Command="{Binding CancelCommand}" />
                        <local:SOrButton Content="{Binding DiscardText}" Variant="Secondary"
                                        Command="{Binding DiscardCommand}" Margin="10,0,0,0" />
                        <local:SOrButton Content="{Binding SaveText}" Variant="Primary"
                                        Command="{Binding SaveCommand}" Margin="10,0,0,0" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
